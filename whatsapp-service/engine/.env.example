# Local engine settings for docker-compose.local.yml. Copy to .env.local (never committed).
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d

# The engine's API key (the service's ENGINE_API_KEY must be the same).
EVOLUTION_API_KEY=
# Password of the local Postgres (user `evolution`), used by the engine and the service.
POSTGRES_PASSWORD=
# The secret in the webhook URL the engine calls; the service's ENGINE_WEBHOOK_SECRET must be the same.
ENGINE_WEBHOOK_SECRET=
