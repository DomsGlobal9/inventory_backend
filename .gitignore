# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Secrets -- service-to-service signing keys and seeded login credentials.
# These were NOT excluded before: this file was saved as UTF-16, so git read the
# rules as binary garbage and matched none of them. Rewritten as UTF-8 so they work.
dev-keys/
*.pem
*.key
test-creds.json
login-creds.txt

# Local dev / scratch scripts.
# Matches the convention set by commit 0fb71d3 "chore: remove test and seed scripts
# from git", which deliberately untracked all of these. src/scripts/ is kept tracked
# (apart from the seed script removed there) because it holds the regression suites.
add_schema.ts
generate-test-creds.ts
seed-test-users.ts
/scripts/
src/scripts/seed-rbac.ts
/test-alerts.ts
/test-endpoint.ts
/test-stats.ts
/test-ui.ts
/trigger-alert.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store

# Tenant snapshots taken before a purge. Real customer data -- never committed.
backups/
