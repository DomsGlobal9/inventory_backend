# Environment for the Inventory service.
#
# Copy to .env for local work, or paste the blocks you need into Render's
# Environment -> "Add from .env". Real values never belong in this file or in git.
#
# Everything here is validated at boot by src/config/env.ts. A misconfigured deployment
# fails THERE, loudly, with the variable named -- rather than booting, passing its health
# check, and throwing on a user's first real action.

# --- Core ---------------------------------------------------------------------------
NODE_ENV=production
# Render injects PORT at runtime. Only set it locally.
# PORT=4006

DATABASE_URL=postgresql://user:password@host:5432/dbname
# Declared as `directUrl` in schema.prisma. Migrations use it, and `prisma migrate deploy`
# fails on the deploy host without it -- a confusing place to discover the omission.
DIRECT_URL=postgresql://user:password@host:5432/dbname

# At least 32 characters in production. Never the value committed in the repo's history:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The deployed frontend origin. The localhost default is correct for dev and actively wrong
# in production -- it makes CORS reject every browser request, which shows up as
# inexplicable errors in the app while curl works fine.
FRONTEND_URL=https://your-frontend-host

# --- Encryption ---------------------------------------------------------------------
# AES-256-GCM key for reversible credential storage: exactly 64 hex characters.
# Required in production -- client onboarding and Team & Users password viewing throw
# without it. Also what encrypts Shopify access tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- Images -------------------------------------------------------------------------
# Required in production: product image upload fails silently without them.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# --- Gateway ------------------------------------------------------------------------
AUTH_MODE=local
# GATEWAY_PUBLIC_KEY_PATH=
# INVENTORY_PRIVATE_KEY_PATH=
# TRUSTED_SERVICES_KEYS={}

# --- Storefront ---------------------------------------------------------------------
# Signs outbound webhooks to a merchant's own website. At least 32 characters.
#
# Deliberately NOT the same secret as INTERNAL_SERVICE_KEY: that one also authenticates
# inbound internal calls, and an earlier implementation sent it to every merchant as a
# header -- handing each of them the key that guards internal traffic.
#
# Fails SAFE when unset: deliveries are requeued and the reason is written to the log the
# merchant can see, rather than being sent unsigned or silently dropped. The feature simply
# does not deliver until this is configured.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STOREFRONT_SIGNING_SECRET=

# --- Shopify ------------------------------------------------------------------------
# From the Shopify app's "App settings" page: Client ID and Client secret.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The PUBLIC origin Shopify redirects back to. Two rules, both of which cause failures that
# are hard to diagnose:
#
#   NO TRAILING SLASH. The code appends /api/v1/shopify/callback, and Shopify compares the
#   redirect URI as a string -- a double slash fails every install with a mismatch.
#
#   USE THE PERMANENT HOSTNAME, not the hosting provider's. A Shopify redirect URL is fixed
#   for the life of every installation: changing it later means every merchant who has
#   installed the app has to install it again.
SHOPIFY_APP_URL=https://shopify.scaleezy.com

# Pinned and dated rather than "latest": Shopify retires API versions on a fixed quarterly
# schedule, so an integration that silently follows the newest one breaks on their timetable
# instead of ours. Must match the Webhooks API version set in the Shopify app.
SHOPIFY_API_VERSION=2026-07

# Requested at install. Has a default that matches the app configuration, so it is usually
# left unset. A merchant can grant fewer than these; what was actually granted is stored per
# installation and checked before any operation that depends on one.
# SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_publications,write_publications

# --- Optional -----------------------------------------------------------------------
# Both fail safe when unset: the service-key branch cannot match, and the admin-secret
# endpoint refuses everything.
# INTERNAL_SERVICE_KEY=
# ADMIN_SECRET=

# Submissions allowed per address per hour on the PUBLIC signup form. The default is the
# production value; raise it only to run the signup suite end to end.
# SIGNUP_RATE_LIMIT_MAX=5

# CATALOG_TRYON_GATEWAY_URL=
# CATALOG_TRYON_API_KEY=
# STOREFRONT_WEBHOOK_URL=
