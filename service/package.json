{
  "name": "scaleezy-whatsapp-service",
  "version": "0.1.0",
  "private": true,
  "description": "ScaleEzy WhatsApp Service: owns every WhatsApp number and sends through the engine (Evolution API).",
  "type": "commonjs",
  "engines": {
    "node": ">=20.20.2 <21"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:prod": "prisma migrate deploy && node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:integration": "tsx test/integration/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "module:create": "tsx scripts/create-module.ts",
    "db:migrate": "prisma migrate deploy",
    "smoke": "tsx scripts/smoke.ts",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "4.22.3",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
