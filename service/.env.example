# ScaleEzy WhatsApp Service. Copy to .env for local runs; on Render these come from the
# blueprint (render.yaml) and the dashboard. The service refuses to start if a required one is
# missing or malformed.

NODE_ENV=development
PORT=18081
LOG_LEVEL=info

# Our own database `whatsapp` (same Postgres server as the engine's `evolution` database).
DATABASE_URL=postgresql://evolution:CHANGE_ME@127.0.0.1:15432/whatsapp?schema=public
# Only for `npm test` (resilience tests). A separate, throwaway database; it is wiped.
TEST_DATABASE_URL=postgresql://evolution:CHANGE_ME@127.0.0.1:15432/whatsapp_test?schema=public

# The engine (Evolution API). host:port is fine too (http:// is added).
ENGINE_URL=http://127.0.0.1:18080
# Same value as the engine's AUTHENTICATION_API_KEY (min 16 chars).
ENGINE_API_KEY=
# The secret in the engine's webhook URL: .../engine/events/<this> (min 24 chars).
ENGINE_WEBHOOK_SECRET=

# Platform console key, sent as x-admin-key (min 24 chars).
ADMIN_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts module webhook secrets. Never change it once modules exist (their secrets would be unreadable).
ENCRYPTION_KEY=

# The engine instance linked to ScaleEzy's own number (locally the Phase 0 instance).
SCALEEZY_INSTANCE=phase0-test
# Messages per Indian day from the ScaleEzy number.
SCALEEZY_DAILY_CAP=150

# Sending worker (only one instance ever sends; Postgres advisory lock).
WORKER_ENABLED=true
SEND_GAP_MIN_MS=4000
SEND_GAP_MAX_MS=9000
HEALTH_WATCH_INTERVAL_MS=300000

# Daily canary: ScaleEzy number -> CANARY_TO (default: the ScaleEzy number itself).
CANARY_ENABLED=false
CANARY_TO=
CANARY_HOUR_IST=9
