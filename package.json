{
  "name": "inventory-service",
  "version": "1.0.0",
  "description": "ScaleEzy Inventory Microservice",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && prisma migrate deploy && tsc",
    "snapshots:daily": "ts-node src/jobs/snapshot.job.ts",
    "snapshots:backfill": "ts-node src/jobs/backfill.job.ts",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
