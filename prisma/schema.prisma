datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── ENUMS ───

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductCategory {
  WOMEN
  MEN
  KIDS
  UNISEX
}

enum LocationType {
  STORE
  ONLINE
  WAREHOUSE
}

enum SalesChannel {
  POS
  ONLINE
  MANUAL
  MARKETPLACE
}

/// How a counter order leaves the shop. Null for orders that did not start at the counter.
enum SalesOrderHandover {
  /// Paid and carried out at the counter.
  TAKEN_NOW
  /// Held at the store for the customer to collect, or to be delivered.
  KEEP_FOR_CUSTOMER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  /// Loyalty points spent on the bill. Money the shop already owed the customer, not money in.
  POINTS
  /// Store credit: money the shop owes the customer from a return, spent on a bill (or given as
  /// credit instead of money on a refund row).
  CREDIT
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum ProductType {
  READY_TO_WEAR
  CUSTOM
}

enum BarcodeType {
  INTERNAL_CODE128
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  TRASHED
  OUT_OF_STOCK
}

enum ProductImageType {
  COVER
  GALLERY
  RAW_UPLOAD
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum InventoryReason {
  PURCHASE
  SALE
  DAMAGE
  RETURN
  CUSTOMER_RETURN
  ADJUSTMENT
  RETURN_TO_VENDOR
  SAMPLE
  MANUAL_ADJUSTMENT
  TRANSFER
  AUDIT
  INITIAL_STOCK
  SUPPLIER_DELIVERY
  MANUAL_CORRECTION
  AUDIT_CORRECTION
  PURCHASE_RECEIPT
  /// Pieces moved from one shelf to another inside the same location. The location's quantity does not
  /// change, so the row carries quantity 0; where they went is in its shelf legs.
  SHELF_MOVE
}

/// What a storage spot is, for its label and icon. Not a rule: any kind can sit at any depth.
enum StorageSpotKind {
  AREA
  RACK
  CUPBOARD
  SHELF
  BOX
  STACK
  BUNDLE
  RAIL
  RAIL_SECTION
  COUNTER
  DRAWER
  DISPLAY
  TRUNK
  OTHER
}

/// Whether a person named the shelf (a scan, or a choice on screen) or the deduction rule chose it.
enum SpotLegSource {
  SCANNED
  AUTO
}

enum ShelfIssueKind {
  /// A till sale found nothing on the shop floor or unshelved, and took pieces from a back-room shelf.
  SOLD_FROM_BACK_ROOM
  /// A reduction other than a sale named no shelf, and unshelved stock could not cover it.
  AUTO_TAKEN_FROM_SHELF
  /// A location-level count found fewer pieces than the shelves said they held.
  COUNT_BELOW_SHELVES
  /// Someone went to a shelf and the pieces were not there.
  NOT_FOUND_ON_SHELF
}

enum ShelfIssueStatus {
  OPEN
  RESOLVED
}

enum ReservationStatus {
  ACTIVE
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ─── CATALOG CONFIG ───

model CatalogTemplate {
  id          String                @id @default(uuid())
  name        String                @unique // e.g. "Default", "Women's Fashion"
  description String?
  isActive    Boolean               @default(true) @map("is_active")
  items       CatalogTemplateItem[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("catalog_templates")
}

model CatalogTemplateItem {
  id         String          @id @default(uuid())
  templateId String          @map("template_id")
  template   CatalogTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type       String // SIZE | COLOR | DRESS_TYPE | MATERIAL | DESIGN_TYPE | PRODUCT_TYPE | CATEGORY
  value      String
  label      String
  category   String? // Optional scope (e.g., WOMEN)
  metadata   Json? // { hex, shades, etc. }
  sortOrder  Int             @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, type, value, category])
  @@index([templateId])
  @@map("catalog_template_items")
}

model ClientCatalogItem {
  id        String  @id @default(uuid())
  clientId  String  @map("client_id")
  type      String // SIZE | COLOR | DRESS_TYPE | MATERIAL | DESIGN_TYPE | PRODUCT_TYPE | CATEGORY
  value     String
  label     String
  category  String?
  metadata  Json?
  sortOrder Int     @default(0) @map("sort_order")
  isSystem  Boolean @default(true) @map("is_system") // True if copied from template, false if added by client
  isActive  Boolean @default(true) @map("is_active") // Soft-delete support

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, type, value, category])
  @@index([clientId, type, isActive])
  @@map("client_catalog_items")
}

// ─── INVENTORY MODULE SCHEMA ───

// 0. STOCK LOCATIONS
model StockLocation {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  code   String
  name   String
  type   LocationType
  active Boolean      @default(true)

  stocks       InventoryStock[]
  salesOrders  SalesOrder[]
  transactions InventoryTransaction[]
  reservations InventoryReservation[]

  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  locationProfiles VariantLocationProfile[]
  InventoryAlert   InventoryAlert[]
  InventoryEvent   InventoryEvent[]
  stockCounts      StockCount[]
  dailySnapshots   DailyLocationSnapshot[]
  purchaseReceipts PurchaseReceipt[]
  /// Orders to be delivered here.
  purchaseOrders   PurchaseOrder[]
  /// Money taken or paid back at this store.
  payments         SalesOrderPayment[]
  /// Its racks, shelves and boxes.
  storageSpots     StorageSpot[]
  firstFill        LocationFirstFill?
  spotStocks       SpotStock[]
  shelfIssues      ShelfIssue[]

  /// Where this store is, and who to call there: the delivery address on a purchase order.
  address String?
  phone   String?

  @@unique([clientId, code])
  @@index([clientId])
  @@map("inventory_locations")
}

model InventoryStock {
  id String @id @default(uuid())

  clientId   String @map("client_id")
  variantId  String @map("variant_id")
  locationId String @map("location_id")

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  quantity    Int @default(0)
  reservedQty Int @default(0) @map("reserved_qty")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variantId, locationId])
  @@index([clientId, locationId])
  @@map("inventory_stocks")
}

// ─── RACKS AND SHELVES ───
//
// Where inside a location the pieces are. The location's InventoryStock.quantity stays the official
// number; shelves divide it. Not shelved is never stored: it is that quantity minus the shelf total,
// and the database refuses any commit where the shelf total is larger (migration
// 20260917120000_racks_and_shelves).

/// A point in a location's rack tree: an area, a rack or cupboard, a shelf, a box. Up to 4 deep, and each
/// branch as deep as that shop needs. Stock sits only on a spot with nothing under it.
model StorageSpot {
  id         String        @id @default(uuid())
  clientId   String        @map("client_id")
  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  parentId String?       @map("parent_id")
  parent   StorageSpot?  @relation("StorageSpotTree", fields: [parentId], references: [id], onDelete: Restrict)
  children StorageSpot[] @relation("StorageSpotTree")

  kind    StorageSpotKind
  /// This spot's own part of the address: C2, 1, A.
  code    String
  /// The whole address, upper case, unique in the location: FLOOR-C2-1-A.
  address String
  /// What the shop calls it, free to change: "Silk sarees, blue box".
  name    String?
  depth   Int

  /// Position in the walk through the shop, among its siblings.
  walkOrder   Int     @default(0) @map("walk_order")
  /// Set on an area and carried by everything under it. Till sales take from these first.
  isShopFloor Boolean @default(false) @map("is_shop_floor")
  /// Printed in the QR label. Never changes, so a label survives a new address.
  labelCode   String  @map("label_code")

  colour      String?
  /// Roughly how many pieces fit. A warning, never a refusal.
  capacity    Int?
  isTemporary Boolean @default(false) @map("is_temporary")
  active      Boolean @default(true)

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stocks         SpotStock[]
  legs           InventoryTransactionSpot[]
  issues         ShelfIssue[]
  addressChanges StorageSpotAddressChange[]
  fillState      SpotFillState?

  @@unique([locationId, address])
  @@unique([clientId, labelCode])
  @@index([clientId, locationId])
  @@index([parentId])
  @@map("storage_spots")
}

/// How far the FIRST FILL has got on one shelf. Onboarding, not stock: a shelf can be COMPLETED and
/// hold nothing, and a quantity can never say whether a person has been there. No row means NOT_STARTED.
model SpotFillState {
  id         String      @id @default(uuid())
  clientId   String      @map("client_id")
  locationId String      @map("location_id")
  spotId     String      @unique @map("spot_id")
  spot       StorageSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  state SpotFillStateKind @default(NOT_STARTED)

  /// Who is on this shelf now: a courtesy for the next phone, never a lock.
  claimedBy  String?   @map("claimed_by")
  claimedAt  DateTime? @map("claimed_at")
  finishedBy String?   @map("finished_by")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, locationId, state])
  @@map("spot_fill_states")
}

enum SpotFillStateKind {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// The first fill of one location. While it is FILLING, a till sale takes from Not shelved first, so
/// shelves somebody has just counted stay right (decision D1). It ends by itself only when every
/// shelf is COMPLETED and at least one was filled, or when a person with shelf:manage presses Finished.
model LocationFirstFill {
  id         String        @id @default(uuid())
  clientId   String        @map("client_id")
  locationId String        @unique @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  state FirstFillState @default(NOT_STARTED)

  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  finishedBy    String?   @map("finished_by")
  /// True when the last shelf finished it, false when a person pressed Finished.
  endedByItself Boolean?  @map("ended_by_itself")
  reopenedAt    DateTime? @map("reopened_at")
  reopenedBy    String?   @map("reopened_by")
  /// Set when the day-7 reminder has gone, so it is sent once.
  remindedAt    DateTime? @map("reminded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, state])
  @@map("location_first_fills")
}

enum FirstFillState {
  NOT_STARTED
  FILLING
  FINISHED
}

/// One shelf's save during the first fill, remembered by the key the phone made. A retry after the
/// network dropped gets the same answer back instead of putting the pieces away a second time.
model ShelfFillSave {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  spotId    String   @map("spot_id")
  /// Made on the phone, once per shelf visit.
  saveKey   String   @map("save_key")
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, saveKey])
  @@index([spotId])
  @@map("shelf_fill_saves")
}

/// Pieces of one variant on one spot. A row reaching 0 is deleted.
model SpotStock {
  id         String         @id @default(uuid())
  clientId   String         @map("client_id")
  locationId String         @map("location_id")
  location   StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  spotId     String         @map("spot_id")
  spot       StorageSpot    @relation(fields: [spotId], references: [id], onDelete: Restrict)
  variantId  String         @map("variant_id")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([spotId, variantId])
  @@index([variantId, locationId])
  @@index([clientId, locationId])
  @@map("spot_stocks")
}

/// One shelf's part of a stock movement: a sale that took 4 from A-03-2 and 1 from B-01-1 is one
/// inventory_transactions row with two of these.
model InventoryTransactionSpot {
  id            String               @id @default(uuid())
  clientId      String               @map("client_id")
  transactionId String               @map("transaction_id")
  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// Null once the spot is deleted; the address is kept.
  spotId  String?      @map("spot_id")
  spot    StorageSpot? @relation(fields: [spotId], references: [id], onDelete: SetNull)
  address String

  variantId  String        @map("variant_id")
  locationId String        @map("location_id")
  quantity   Int
  source     SpotLegSource

  createdAt DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([spotId, createdAt])
  @@index([variantId, locationId, createdAt])
  @@map("inventory_transaction_spots")
}

/// Something about the shelves that did not add up, shown to the shop instead of being corrected quietly.
model ShelfIssue {
  id         String         @id @default(uuid())
  clientId   String         @map("client_id")
  locationId String         @map("location_id")
  location   StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variantId  String         @map("variant_id")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  spotId  String?      @map("spot_id")
  spot    StorageSpot? @relation(fields: [spotId], references: [id], onDelete: SetNull)
  address String?

  transactionId String?               @map("transaction_id")
  transaction   InventoryTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  kind     ShelfIssueKind
  quantity Int
  message  String         @db.Text

  status         ShelfIssueStatus @default(OPEN)
  resolvedBy     String?          @map("resolved_by")
  resolvedAt     DateTime?        @map("resolved_at")
  resolutionNote String?          @map("resolution_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, status, createdAt])
  @@index([locationId, status])
  @@index([variantId])
  @@map("shelf_issues")
}

/// A spot's address before and after a change. Kept here rather than in audit_logs, which prunes.
model StorageSpotAddressChange {
  id         String      @id @default(uuid())
  clientId   String      @map("client_id")
  spotId     String      @map("spot_id")
  spot       StorageSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  oldAddress String      @map("old_address")
  newAddress String      @map("new_address")
  changedBy  String?     @map("changed_by")
  changedAt  DateTime    @default(now()) @map("changed_at")

  @@index([spotId, changedAt])
  @@map("storage_spot_address_changes")
}

// 1. PRODUCT
model Product {
  id          String @id @default(uuid())
  clientId    String @map("client_id")
  productCode String @map("product_code") // e.g. SE-SAREE-001

  /// The merchant's own key for this product, from the file that imported it.
  ///
  /// productCode is generated here, so a spreadsheet describing products that do not exist
  /// yet cannot carry one -- which left an import unable to recognise its own work. Upload
  /// the same file twice and the second run saw two more new products, which is precisely
  /// the duplication the importer exists to avoid.
  ///
  /// This is what the file called ProductKey. Storing it means a re-run finds what it made
  /// last time and updates it. Null for everything created any other way.
  importKey String? @map("import_key")
  slug      String

  // General Info
  title       String
  description String?         @db.Text
  category    ProductCategory
  productType ProductType     @map("product_type")
  dressType   String?         @map("dress_type") // e.g., 'Saree', 'Lehenga'
  fabric      String?
  craft       String?
  brand       String?

  // Pricing & Status
  basePrice   Decimal       @map("base_price") @db.Decimal(10, 2)
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  // Relations
  variants ProductVariant[]
  images   ProductImage[]

  // Soft Delete & Timestamps
  trashedAt      DateTime?      @map("trashed_at")
  previousStatus ProductStatus? @map("previous_status")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([clientId, productCode])
  @@unique([clientId, importKey])
  @@unique([clientId, slug])
  @@index([clientId, title])
  @@index([clientId, status])
  @@index([clientId, category])
  @@map("inventory_products")
}

// 2. PRODUCT VARIANT
model ProductVariant {
  id        String @id @default(uuid())
  productId String @map("product_id")
  clientId  String @map("client_id") // Required for multi-tenant SKU uniqueness

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Identifiers
  variantCode String      @map("variant_code")
  sku         String
  barcodeType BarcodeType @default(INTERNAL_CODE128) @map("barcode_type")

  // Attributes
  size             String?
  colorName        String?  @map("color_name")
  hexCode          String?  @map("hex_code")
  compareAtPrice   Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  costPrice        Decimal? @map("cost_price") @db.Decimal(10, 2)
  lastPurchaseCost Decimal? @map("last_purchase_cost") @db.Decimal(10, 2)

  // Inventory Control
  sellingPrice      Decimal?  @map("selling_price") @db.Decimal(10, 2)
  inventoryValue    Decimal   @default(0) @map("inventory_value") @db.Decimal(10, 2)
  // 6 dp, not 2. Weighted average cost is a DERIVED figure -- receiving 10 units at 1200
  // onto 8 units held at 0 gives 12000/18 = 666.666... -- and inventoryValue is then
  // computed as quantity x averageCost. Rounded to 2 dp the average became 666.67 and the
  // value came back as 12000.06 for stock that cost exactly 12000.00. Small per movement,
  // but it is real money and it compounds over every subsequent receipt. The extra places
  // keep the derived value exact to the paisa; displayed costs are still formatted to 2 dp.
  averageCost       Decimal   @default(0) @map("average_cost") @db.Decimal(18, 6)
  lastCostUpdatedAt DateTime? @map("last_cost_updated_at")
  lastReceivedAt    DateTime? @map("last_received_at")
  lastMovementAt    DateTime? @map("last_movement_at")
  reorderLevel      Int       @default(0) @map("reorder_level")
  reorderQty        Int?      @map("reorder_qty")

  barcode String? @unique

  // Relations
  images               ProductImage[]
  transactions         InventoryTransaction[]
  reservations         InventoryReservation[]
  salesOrderItems      SalesOrderItem[]
  stockCountItems      StockCountItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  stocks               InventoryStock[]
  transfers            InventoryTransfer[]
  supplierLinks        SupplierProduct[]

  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  locationProfiles VariantLocationProfile[]
  InventoryAlert   InventoryAlert[]
  InventoryEvent   InventoryEvent[]
  spotStocks       SpotStock[]
  shelfIssues      ShelfIssue[]

  @@unique([clientId, variantCode], name: "uq_variant_client_code")
  @@unique([clientId, sku])
  @@index([productId])
  @@index([clientId, lastMovementAt])
  @@map("inventory_product_variants")
}

// 2.1 INVENTORY RESERVATION
model InventoryReservation {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  salesOrderItemId String         @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)

  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  status ReservationStatus @default(ACTIVE)

  reservedQty   Int @map("reserved_qty")
  dispatchedQty Int @default(0) @map("dispatched_qty")

  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([variantId])
  @@index([salesOrderItemId])
  @@index([clientId])
  @@index([locationId])
  @@map("inventory_reservations")
}

// 3. PRODUCT IMAGE
model ProductImage {
  id        String          @id @default(uuid())
  productId String?         @map("product_id")
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  url         String  @db.Text
  storagePath String? @map("storage_path")
  fileName    String? @map("file_name")
  fileSize    Int?    @map("file_size")
  altText     String? @map("alt_text")
  isPrimary   Boolean @default(false) @map("is_primary")

  imageType  ProductImageType @map("image_type")
  orderIndex Int              @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([variantId])
  @@map("inventory_product_images")
}

// 4. INVENTORY TRANSACTION
model InventoryTransaction {
  id        String         @id @default(uuid())
  clientId  String         @map("client_id")
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  type   TransactionType
  reason InventoryReason

  // Snapshots for resilience
  sku          String?
  variantCode  String? @map("variant_code")
  barcode      String?
  productTitle String? @map("product_title")

  quantity Int // e.g. 100, -2, +1

  balanceBefore Int @map("balance_before")
  balanceAfter  Int @map("balance_after")

  notes String? @db.Text

  referenceType String?  @map("reference_type") // e.g. "ORDER", "PO"
  referenceId   String?  @map("reference_id")
  unitCost      Decimal? @map("unit_cost") @db.Decimal(10, 2)
  totalCost     Decimal? @map("total_cost") @db.Decimal(15, 2)

  metadata  Json?
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Which shelves this movement touched. Not a second ledger: the legs belong to this row.
  spotLegs    InventoryTransactionSpot[]
  shelfIssues ShelfIssue[]

  @@index([clientId, createdAt])
  @@index([variantId, createdAt])
  @@index([locationId])
  @@index([type])
  @@index([reason])
  @@map("inventory_transactions")
}

model InventoryTransfer {
  id             String @id @default(uuid())
  clientId       String @map("client_id")
  transferNumber String @map("transfer_number")

  fromLocationId String @map("from_location_id")
  toLocationId   String @map("to_location_id")

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int
  status   TransferStatus @default(REQUESTED)

  notes String? @db.Text

  requestedBy String? @map("requested_by")
  approvedBy  String? @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, transferNumber])
  @@index([clientId, status])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("inventory_transfers")
}

// 5. LABEL TEMPLATE
model LabelTemplate {
  id          String  @id @default(uuid())
  clientId    String  @map("client_id")
  name        String
  width       Int // e.g., 50 (mm)
  height      Int // e.g., 25 (mm)
  showPrice   Boolean @default(true) @map("show_price")
  showSku     Boolean @default(true) @map("show_sku")
  showBarcode Boolean @default(true) @map("show_barcode")
  isDefault   Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("inventory_label_templates")
}

// 6. SEQUENCES
model ClientSequence {
  id         String @id @default(uuid())
  clientId   String @map("client_id")
  entityType String @map("entity_type") // e.g. "PRODUCT", "VARIANT"
  lastValue  Int    @default(0) @map("last_value")

  @@unique([clientId, entityType])
  @@map("inventory_client_sequences")
}

// 7. STOCK COUNT (AUDIT)
model StockCount {
  id         String           @id @default(uuid())
  clientId   String           @map("client_id")
  name       String // e.g., "August Monthly Count"
  status     StockCountStatus @default(DRAFT)
  locationId String?          @map("location_id")
  location   StockLocation?   @relation(fields: [locationId], references: [id])

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdBy   String? @map("created_by")
  completedBy String? @map("completed_by")

  // Persisted Audit Summary Metrics
  totalItems    Int?     @map("total_items")
  matchedItems  Int?     @map("matched_items")
  adjustedItems Int?     @map("adjusted_items")
  accuracy      Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items StockCountItem[]

  @@index([clientId])
  @@map("inventory_stock_counts")
}

model StockCountItem {
  id           String     @id @default(uuid())
  stockCountId String     @map("stock_count_id")
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshot of identifiers at the time of audit
  sku         String
  variantCode String  @map("variant_code")
  barcode     String?

  expectedQty Int  @map("expected_qty")
  countedQty  Int? @map("counted_qty")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stockCountId, variantId])
  @@map("inventory_stock_count_items")
}

// ─── SUPPLIERS & PURCHASE ORDERS ───

model Supplier {
  id           String @id @default(uuid())
  clientId     String @map("client_id")
  supplierCode String @map("supplier_code")

  name    String
  email   String?
  phone   String?
  address String?

  isActive Boolean @default(true) @map("is_active")

  lastOrderDate DateTime? @map("last_order_date")
  totalOrders   Int       @default(0) @map("total_orders")

  purchaseOrders PurchaseOrder[]
  suppliedItems  SupplierProduct[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, supplierCode], name: "uq_supplier_client_code")
  @@index([clientId])
  @@map("suppliers")
}

model PurchaseOrder {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  poNumber String @map("po_number")

  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// The store this order is for: where the supplier delivers and where receiving expects the
  /// goods. Empty only on older orders whose store could not be worked out.
  locationId String?        @map("location_id")
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  status PurchaseOrderStatus @default(DRAFT)

  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  receivedAt           DateTime? @map("received_at")

  totalAmount Decimal? @map("total_amount")
  notes       String?

  items    PurchaseOrderItem[]
  /// One per delivery received against this order, newest last.
  receipts PurchaseReceipt[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, poNumber], name: "uq_po_client_number")
  @@index([clientId])
  @@index([supplierId])
  @@index([clientId, locationId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid())

  poId String        @map("po_id")
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshots
  sku          String
  variantCode  String  @map("variant_code")
  barcode      String?
  supplierSku  String? @map("supplier_sku")
  productTitle String  @map("product_title")
  color        String?
  size         String?

  orderedQty  Int     @map("ordered_qty")
  receivedQty Int     @default(0) @map("received_qty")
  unitPrice   Decimal @map("unit_price")

  lastReceivedAt DateTime? @map("last_received_at")

  receiptItems PurchaseReceiptItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([poId])
  @@index([variantId])
  @@map("purchase_order_items")
}

/// One delivery received against a purchase order: a goods receipt note.
///
/// Written in the same transaction as the stock it brings in. Lines keep what they were measured
/// against at the time, so a receipt printed later still reads as it did on the day.
model PurchaseReceipt {
  id            String @id @default(uuid())
  clientId      String @map("client_id")
  receiptNumber String @map("receipt_number")

  poId String        @map("po_id")
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// The account that pressed Confirm Receipt. Kept for the record; not printed.
  receivedById      String? @map("received_by_id")
  recordedByName    String? @map("recorded_by_name")
  /// The person who took the goods, as typed when receiving. This is who the receipt names.
  receivedByName    String? @map("received_by_name")
  receivedByPhone   String? @map("received_by_phone")
  /// The supplier's invoice or delivery challan number.
  supplierReference String? @map("supplier_reference")
  notes             String?
  /// One per press of Confirm Receipt, so a double click returns the same receipt.
  requestKey        String? @map("request_key")

  receivedAt DateTime @default(now()) @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  items PurchaseReceiptItem[]

  @@unique([clientId, receiptNumber], name: "uq_purchase_receipt_number")
  @@unique([clientId, requestKey], name: "uq_purchase_receipt_request")
  @@index([poId])
  @@index([clientId, receivedAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id        String          @id @default(uuid())
  receiptId String          @map("receipt_id")
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  poItemId String            @map("po_item_id")
  poItem   PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  sku          String
  variantCode  String? @map("variant_code")
  productTitle String  @map("product_title")
  color        String?
  size         String?

  /// On the order, and already received before this delivery.
  orderedQty     Int     @map("ordered_qty")
  receivedBefore Int     @map("received_before")
  /// Arrived in this delivery.
  quantity       Int
  unitPrice      Decimal @map("unit_price")

  @@index([receiptId])
  @@index([poItemId])
  @@map("purchase_receipt_items")
}

// ─── REPORTING & SNAPSHOTS ───

model DailyInventorySnapshot {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  snapshotDate  DateTime @map("snapshot_date")
  totalValue    Decimal  @default(0) @map("total_value") @db.Decimal(15, 2)
  totalUnits    Int      @default(0) @map("total_units")
  totalVariants Int      @default(0) @map("total_variants")

  activeProducts Int     @default(0) @map("active_products")
  lowStockCount  Int     @default(0) @map("low_stock_count")
  deadStockValue Decimal @default(0) @map("dead_stock_value") @db.Decimal(15, 2)
  openPoValue    Decimal @default(0) @map("open_po_value") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, snapshotDate])
  @@index([clientId, snapshotDate])
  @@map("inventory_daily_snapshots")
}

// --- SALES ENGINE (PHASE 2) ---

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerType {
  WALK_IN
  REGISTERED
}

model Customer {
  id                 String  @id @default(uuid())
  clientId           String  @map("client_id")
  customerCode       String  @map("customer_code")
  externalCustomerId String? @map("external_customer_id")

  name        String
  companyName String? @map("company_name")
  /// Stored one way, "+919848022338" (src/lib/phone.ts). One live customer per number per shop, held by the
  /// partial unique index customers_client_id_phone_live_key (migration 20260916100000), which Prisma cannot
  /// express. Empty only for customers from outside the shop whose number was missing or already taken.
  phone       String?
  email       String?
  gstNumber   String? @map("gst_number")

  billingAddress  String? @db.Text
  shippingAddress String? @db.Text

  status       CustomerStatus @default(ACTIVE)
  customerType CustomerType   @default(REGISTERED) @map("customer_type")

  notes String? @db.Text

  /// Groups the customer belongs to -- VIP, STAFF, WHOLESALE. What an offer's customerTags match.
  tags String[] @default([])

  /// The Shopify store (shop domain) this customer arrived from, or null. shop/redact erases one
  /// store's customers, and a workspace can connect several stores.
  sourceStore String? @map("source_store")

  /// Agreed to hear about offers on WhatsApp. Off until somebody at the shop records that the
  /// customer said yes -- who and when are kept as the proof (DPDP Act). Campaigns reach only these.
  whatsappOffers    Boolean   @default(false) @map("whatsapp_offers")
  whatsappOffersAt  DateTime? @map("whatsapp_offers_at")
  whatsappOffersBy  String?   @map("whatsapp_offers_by")
  /// Replied STOP to the shop's number. Never messaged again from it (the WhatsApp Service keeps STOP for ever).
  whatsappStoppedAt DateTime? @map("whatsapp_stopped_at")

  /// "MM-DD", no year: a birthday wish needs the day, not the age.
  birthday    String?
  anniversary String?

  /// Loyalty points held now: the sum of loyalty_entries, kept here so a redemption can take them
  /// with one guarded UPDATE (never below what is held) and campaigns can filter on it.
  loyaltyPoints   Int       @default(0) @map("loyalty_points")
  /// Last time points were earned or used -- points expire after a quiet spell, not by batch.
  loyaltyActiveAt DateTime? @map("loyalty_active_at")

  /// Store credit held, in paise: a return refunded as credit, or an exchange's value, waiting to
  /// be spent. The sum of store_credit_entries, moved together with them.
  storeCreditPaise Int @default(0) @map("store_credit_paise")

  salesOrders        SalesOrder[]
  loyaltyEntries     LoyaltyEntry[]
  storeCreditEntries StoreCreditEntry[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, customerCode])
  @@unique([clientId, externalCustomerId])
  @@index([clientId])
  @@index([clientId, sourceStore])
  @@map("customers")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

model SalesOrder {
  id          String @id @default(uuid())
  clientId    String @map("client_id")
  orderNumber String @map("order_number")

  externalOrderId String? @map("external_order_id")
  sourceSystem    String? @map("source_system")

  /// The selling system's own "last changed" stamp for this order.
  ///
  /// Shopify redelivers webhooks and does not promise order: an `orders/updated` from two
  /// minutes ago can arrive after a newer one. Comparing against this is what makes that
  /// self-correcting -- anything older than what we already hold is dropped rather than
  /// applied, the same last-writer-wins rule StorefrontEvent.sequence uses in the other
  /// direction. Timestamps cannot order two events in the same millisecond, which is why this
  /// only ever DISCARDS; it never decides which of two simultaneous changes wins.
  externalUpdatedAt DateTime? @map("external_updated_at")

  /// The Shopify store (shop domain) that sent this order, or null. See Customer.sourceStore.
  sourceStore String? @map("source_store")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// The person who rang it up. Null for orders a system wrote (Shopify), and kept if they leave.
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Counter orders only: whether the goods went with the customer or are kept for them.
  handover SalesOrderHandover?

  // Customer Snapshot Fields
  customerName    String? @map("customer_name")
  customerPhone   String? @map("customer_phone")
  shippingAddress String? @map("shipping_address") @db.Text
  billingAddress  String? @map("billing_address") @db.Text

  channel    SalesChannel  @default(POS)
  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  status SalesOrderStatus @default(DRAFT)

  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  shippingAmount Decimal @default(0) @map("shipping_amount") @db.Decimal(10, 2)
  total          Decimal @default(0) @db.Decimal(10, 2)

  items      SalesOrderItem[]
  dispatches Dispatch[]
  returns    SalesReturn[]
  discounts  SalesOrderDiscount[]
  payments   SalesOrderPayment[]

  /// Set only when this order was placed on the shop's own online shop.
  onlineShopOrder OnlineShopOrder?

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, orderNumber])
  @@unique([clientId, externalOrderId, sourceSystem], name: "uq_external_order")
  @@index([clientId])
  @@index([customerId])
  @@index([locationId])
  @@index([clientId, sourceStore])
  @@index([createdById])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity     Int
  fulfilledQty Int @default(0) @map("fulfilled_qty")

  /// What this variant costs before anything is taken off, per unit.
  ///
  /// Inventory never originates a sales order: every one arrives from a till, a website or a
  /// Shopify checkout that has ALREADY quoted a price to somebody. Until this column existed
  /// there was nowhere to record that two prices were involved, so `createFullOrder` resolved
  /// the catalogue price and discarded whatever the caller said it had charged -- a saree sold
  /// at ₹9,600 after ₹2,400 off was filed as a ₹12,000 sale, and grossProfit with it.
  listUnitPrice Decimal @map("list_unit_price") @db.Decimal(10, 2)

  /// Taken off THIS line in total -- not per unit. Mirrors Shopify's discount_allocations,
  /// deliberately, because reconciling an ingested Shopify order against our own offer is much
  /// easier when the two systems record the same shape.
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(10, 2)

  /// This line's share of a discount typed against the WHOLE order.
  ///
  /// Separate from lineDiscount rather than summed into it, so that recalculating an order is
  /// idempotent: changing "₹500 off this order" to "₹300 off" has to replace the allocated
  /// share without touching a markdown that belongs to the line itself. One column holding the
  /// sum cannot tell those two apart on the second edit.
  allocatedDiscount Decimal @default(0) @map("allocated_discount") @db.Decimal(10, 2)

  /// Net price per unit -- what was actually charged, after both discounts above.
  ///
  /// Derived from totalPrice rather than the other way round: three items sharing a ₹100
  /// discount do not divide evenly, and multiplying a rounded unit price back up would not
  /// reproduce the line. Kept as a column because daybook.service and dispatch.service multiply
  /// it by the DISPATCHED quantity to value a part-shipped order, which needs a per-unit figure.
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  unitCost    Decimal @map("unit_cost") @db.Decimal(10, 2)
  /// Authoritative. listUnitPrice x quantity, less lineDiscount, less allocatedDiscount.
  totalPrice  Decimal @map("total_price") @db.Decimal(15, 2)
  totalCost   Decimal @default(0) @map("total_cost") @db.Decimal(15, 2)
  /// Computed from the NET total, so a discounted sale no longer reports the margin of an
  /// undiscounted one.
  grossProfit Decimal @default(0) @map("gross_profit") @db.Decimal(15, 2)

  /// Who decided this line's price, so that "we trusted the caller" is auditable afterwards
  /// rather than inferred. CATALOGUE | EXTERNAL | QUOTE | MANUAL -- see services/pricing.
  priceSource String @default("CATALOGUE") @map("price_source")

  dispatchItems         DispatchItem[]
  inventoryReservations InventoryReservation[]
  discountAllocations   SalesOrderItemDiscount[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([salesOrderId])
  @@index([variantId])
  @@map("sales_order_items")
}

enum DispatchStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Dispatch {
  id           String     @id @default(uuid())
  clientId     String     @map("client_id")
  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  dispatchNumber String         @map("dispatch_number")
  status         DispatchStatus @default(PENDING)

  dispatchedAt DateTime? @map("dispatched_at")

  items DispatchItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, dispatchNumber])
  @@index([salesOrderId])
  @@map("dispatches")
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String   @map("dispatch_id")
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  salesOrderItemId String         @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  quantity    Int
  returnedQty Int @default(0) @map("returned_qty")

  returnItems SalesReturnItem[]

  @@index([dispatchId])
  @@index([salesOrderItemId])
  @@map("dispatch_items")
}

model SalesLedger {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  salesOrderId String  @map("sales_order_id")
  dispatchId   String? @map("dispatch_id")

  transactionDate DateTime @default(now()) @map("transaction_date")

  revenue     Decimal @db.Decimal(15, 2)
  costOfGoods Decimal @map("cost_of_goods") @db.Decimal(15, 2)
  grossProfit Decimal @map("gross_profit") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([salesOrderId])
  @@map("sales_ledger")
}

// ─── RETURNS ───

enum ReturnStatus {
  REQUESTED
  RECEIVED
  INSPECTED
  COMPLETED
  REJECTED
}

enum ReturnDisposition {
  PENDING
  RESTOCK
  DAMAGED
  SCRAP
}

enum ReturnReason {
  DAMAGED_IN_TRANSIT
  WRONG_ITEM
  SIZE_ISSUE
  CUSTOMER_REJECTED
  DEFECTIVE
  OTHER
}

model SalesReturn {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  returnNumber String @map("return_number")

  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  status ReturnStatus @default(REQUESTED)
  reason ReturnReason

  notes String?

  /// What the customer is owed, and whether it has been paid back.
  ///
  /// A return moved stock and nothing else until now, so nothing could say what a refund was
  /// worth -- and with discounts on a line the answer is emphatically not the list price. For a
  /// Shopify refund this is a RECORD: Shopify has already moved the money.
  refundTotal     Decimal @default(0) @map("refund_total") @db.Decimal(10, 2)
  /// NONE | PENDING | REFUNDED | FAILED
  refundStatus    String  @default("NONE") @map("refund_status")
  /// Of what came back, the part the customer had paid with loyalty points goes back as points,
  /// not money: set when the return is completed, and refundTotal is then the money part only.
  pointsBack      Int     @default(0) @map("points_back")
  pointsBackValue Decimal @default(0) @map("points_back_value") @db.Decimal(10, 2)
  /// Points earned on the returned goods, taken back.
  pointsTakenBack Int     @default(0) @map("points_taken_back")

  /// Taken back at the counter in one step (booked, checked and completed together).
  atCounter        Boolean   @default(false) @map("at_counter")
  /// The screen's own id for that one press, so a retried Complete is the same return.
  counterKey       String?   @unique @map("counter_key")
  /// The store it was handed back at.
  locationId       String?   @map("location_id")
  /// How the money went back: CASH | UPI | CARD | CREDIT (store credit), once recorded.
  refundMethod     String?   @map("refund_method")
  refundedAt       DateTime? @map("refunded_at")
  refundedById     String?   @map("refunded_by_id")
  externalRefundId String?   @map("external_refund_id")

  items SalesReturnItem[]

  completedAt DateTime?           @map("completed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  /// Refunds paid for this return.
  refunds     SalesOrderPayment[]

  @@unique([clientId, returnNumber])
  @@index([salesOrderId])
  @@index([clientId, status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id String @id @default(uuid())

  salesReturnId String      @map("sales_return_id")
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  dispatchItemId String       @map("dispatch_item_id")
  dispatchItem   DispatchItem @relation(fields: [dispatchItemId], references: [id], onDelete: Restrict)

  /// The order line this came off, directly.
  ///
  /// It was only ever reachable through DispatchItem, which is fine for moving stock and no use
  /// at all for money: refunding the NET price needs the line that carries it. Nullable because
  /// every existing row predates this and cannot be filled in reliably.
  salesOrderItemId String? @map("sales_order_item_id")

  quantity Int

  /// What was actually given back for these units. Net, never list.
  refundAmount Decimal @default(0) @map("refund_amount") @db.Decimal(10, 2)

  disposition ReturnDisposition @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([salesReturnId])
  @@index([dispatchItemId])
  @@map("sales_return_items")
}

/// What was taken off an order, and who said so.
///
/// Deliberately the same shape as Shopify's `discount_applications`, because reconciling an
/// ingested Shopify order against our own offer is far easier when both systems record the same
/// thing the same way -- and impossible when they do not.
///
/// `offerId` is nullable on purpose. A merchant can run a discount inside Shopify that ScaleEzy
/// never created, and that order still has to be recorded truthfully. Refusing to ingest sales
/// we cannot explain would lose real money from the books.
model SalesOrderDiscount {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  /// Ours, when we own the rule. Null when it came from elsewhere.
  offerId        String? @map("offer_id")
  offerVersionId String? @map("offer_version_id")

  /// OFFER | SHOPIFY | MANUAL
  source     String
  /// Shopify's discount id or code, for drift detection later.
  externalId String? @map("external_id")

  /// What the customer saw it called.
  title  String
  amount Decimal @db.Decimal(10, 2)

  /// MANUAL: the user who took the money off. The reason is the title.
  appliedBy String? @map("applied_by")
  /// OFFER: the single-use or shared code that unlocked it, when one did.
  code      String?

  allocations SalesOrderItemDiscount[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([salesOrderId])
  @@index([offerId])
  @@map("sales_order_discounts")
}

/// How one discount was divided between the lines it applied to.
///
/// Shopify's `discount_allocations`. Without it a two-line order with one 500-off code cannot
/// say which line to refund what, and a partial return guesses.
model SalesOrderItemDiscount {
  id String @id @default(uuid())

  salesOrderItemId String         @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)

  salesOrderDiscountId String             @map("sales_order_discount_id")
  salesOrderDiscount   SalesOrderDiscount @relation(fields: [salesOrderDiscountId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([salesOrderItemId])
  @@index([salesOrderDiscountId])
  @@map("sales_order_item_discounts")
}

/// A Shopify order we could not place, kept until somebody can.
///
/// Every reason below is a decision a person has to make -- which of our locations this shop's
/// orders belong to, what this unrecognised SKU is. Guessing any of them writes a real sale
/// against the wrong shop floor, and dropping them loses money that was actually taken.
///
/// So the order is parked with its whole payload and replayed once the decision exists. The
/// alternative, discovered in every integration that does not do this, is a merchant asking why
/// their Shopify total and their ScaleEzy total differ and nobody being able to say.
model ShopifyOrderInbox {
  id String @id @default(uuid())

  shopDomain     String  @map("shop_domain")
  /// Null while the installation is still unclaimed -- we do not yet know whose order it is.
  clientId       String? @map("client_id")
  shopifyOrderId String  @map("shopify_order_id")
  topic          String

  /// The webhook body, verbatim. Replay must use what Shopify actually sent, not our reading
  /// of it at the time -- our reading is the thing that was wrong.
  payload Json

  /// UNMAPPED_LOCATION | UNMAPPED_VARIANT | CURRENCY_MISMATCH | NOT_SYNCED
  /// | UNCLAIMED_INSTALL | RECONCILE_MISMATCH | FAILED
  reason String
  detail String? @db.Text

  attempts     Int       @default(0)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedBy   String?   @map("resolved_by")
  /// The order it eventually became, once it was replayed successfully.
  salesOrderId String?   @map("sales_order_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// A redelivered webhook updates its parked row instead of adding a second one.
  @@unique([shopDomain, shopifyOrderId, topic], name: "uq_inbox_order_topic")
  @@index([clientId, resolvedAt])
  @@index([shopDomain, createdAt])
  @@map("shopify_order_inbox")
}

// ─── RBAC & AUTH ───

model User {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// Raised whenever every existing sign-in of this person must stop working: a password change or
  /// reset, being switched off, or "sign out of other devices". Every token carries the number it was
  /// issued with, and one that no longer matches is refused.
  sessionVersion Int @default(0) @map("session_version")

  name              String
  email             String
  password          String
  // AES-256-GCM encrypted copy of the current password, decryptable server-side, so a
  // Super Admin/Admin can view (not just reset) a staff member's password to re-share it.
  // `password` above (bcrypt, one-way) is what login actually checks -- this field is never
  // used for authentication. Nullable: platform-admin-onboarded SUPER_ADMIN accounts and
  // any row predating this feature won't have one until their password is next set here.
  passwordEncrypted String? @map("password_encrypted")

  status UserStatus @default(ACTIVE)

  roles UserRole[]

  /// Quarantined on 12 Sep 2026 -- see the note above DailyReportJob. These two columns
  /// exist in production with real data (3 users opted in) and are declared here so that
  /// Prisma stops treating them as drift to be dropped. Nothing in THIS repository reads
  /// or writes them.
  phone              String?
  receiveDailyReport Boolean @default(false) @map("receive_daily_report")

  /// When this person finished (or skipped) the short tour of the app. Null means they have never
  /// seen it, which is what makes them "new". Kept on the account, not in the browser, so it does
  /// not come back on their phone, on a second computer, or after clearing the browser.
  tourSeenAt DateTime? @map("tour_seen_at")

  dailyReportDeliveries DailyReportDelivery[]

  /// Orders this person rang up.
  salesOrdersCreated SalesOrder[]        @relation("SalesOrderCreatedBy")
  /// Money this person took or paid back.
  paymentsReceived   SalesOrderPayment[] @relation("PaymentReceivedBy")

  lastLoginAt  DateTime? @map("last_login_at")
  // Bumped on every authenticated business-API request (see activity-tracker.middleware.ts),
  // not just on login -- lastLoginAt alone under-represents a user who logged in once and
  // then stayed busy in the app for hours, or over-represents someone who logged in and
  // immediately went idle.
  lastActiveAt DateTime? @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, email])
  @@index([clientId])
  @@map("users")
}

// Captures both backend 500s (from error.middleware.ts) and uncaught frontend errors
// (posted from the client via activity-tracker's sibling, the /client-errors route) so the
// Platform Console can see a tenant's crash the moment it happens instead of relying on
// the client to report it. clientId/userId/userEmail are nullable and userEmail is a
// snapshot (not a join) because an error can legitimately happen before login resolves who
// the visitor is, or reference a user later deleted -- the log must never depend on a row
// that might not exist.
model ClientErrorLog {
  id String @id @default(uuid())

  clientId  String? @map("client_id")
  userId    String? @map("user_id")
  userEmail String? @map("user_email")

  source     String // BACKEND | FRONTEND
  message    String
  stack      String?
  route      String?
  statusCode Int?    @map("status_code")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([createdAt])
  @@map("client_error_logs")
}

// ─── PLATFORM ADMIN (Scaleezy-wide console, cross-tenant) ───
// Separate credential store, deliberately NOT a `User` row -- a platform admin isn't
// scoped to any single clientId. See SUPER_ADMIN_PLAN.md for the full design.
model PlatformAdmin {
  id             String     @id @default(uuid())
  email          String     @unique
  password       String
  name           String
  status         UserStatus @default(ACTIVE)
  /// Same as User.sessionVersion, for the platform console.
  sessionVersion Int        @default(0) @map("session_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions PlatformAdminSession[]

  @@map("platform_admins")
}

// One row per "assumed a client's session" event -- the audit trail for cross-tenant access.
model PlatformAdminSession {
  id              String        @id @default(uuid())
  platformAdminId String        @map("platform_admin_id")
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  clientId  String    @map("client_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([platformAdminId])
  @@index([clientId])
  @@map("platform_admin_sessions")
}

// Everything else a platform admin does, which until now left no trace at all.
//
// PlatformAdminSession above records entering a client's account. It was the only console
// action that recorded anything: reading a shop owner's password in plain text, resetting it,
// suspending a shop, deleting one outright, issuing or revoking a service key, changing a
// billing limit and creating another platform admin all happened invisibly.
//
// The plaintext-password path is a deliberate feature -- a client whose only Super Admin
// forgets their password has no other way back in. What makes a capability like that
// acceptable is not that it is rare, it is that using it is recorded.
//
// Deliberately NOT the auditLog table, for two reasons. That one is keyed on clientId and
// pruned to the last 30 rows per client, which is right for "what has my team been doing
// lately" and wrong for a security trail. And it would vanish exactly when it is most needed:
// deleting a client removes their rows, so the record of who deleted them would go with them.
model PlatformAdminAction {
  id String @id @default(uuid())

  platformAdminId String @map("platform_admin_id")
  // Copied, not joined. The trail has to still name who did it after that admin's own account
  // is removed -- which is itself one of the actions recorded here.
  adminEmail      String @map("admin_email")
  adminName       String @map("admin_name")

  action      String // VIEW_PASSWORD, SUSPEND, DELETE_CLIENT, SET_SERVICE_KEY, ...
  // What it was done to, in words rather than ids where possible, for the same reason.
  targetType  String  @map("target_type") // CLIENT, USER, PLATFORM_ADMIN, LEAD, SUPPORT_TICKET
  targetId    String? @map("target_id")
  targetLabel String? @map("target_label")

  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([platformAdminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("platform_admin_actions")
}

model Role {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  name        String
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── AUDIT ───

model AuditLog {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  userId String? @map("user_id")

  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  before Json?
  after  Json?

  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model VariantLocationProfile {
  id         String @id @default(uuid())
  variantId  String @map("variant_id")
  locationId String @map("location_id")

  isAvailable   Boolean  @default(true) @map("is_available")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@map("variant_location_profiles")
}

// ─── ALERT AND OUTBOX SYSTEM ───

enum InventoryAlertType {
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
  REORDER_REQUIRED
  STOCK_DISCREPANCY
  SYSTEM_ERROR
  /// Somebody bought something on the shop's own online shop. It lands in the Alert Centre the
  /// shop already watches, so an order that arrives at nine at night is not found at nine the
  /// next morning.
  ONLINE_ORDER
}

enum InventoryAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ─── SUPPORT TICKETS (client-raised, Platform Console-handled) ───

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  BUG
  QUESTION
  BILLING
  FEATURE_REQUEST
  OTHER
}

// Ticket-level fields snapshot who opened it (name/email) rather than relying on a live
// User join -- same reasoning as ClientErrorLog: the ticket must stay readable even if that
// user is later deactivated or deleted.
model SupportTicket {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// A reference a person can say out loud, e.g. TCK-000007.
  ///
  /// Tickets used to be identified only by their UUID, so a customer writing back had nothing
  /// to quote but 36 characters of hex. Scoped per client like every other code here: two
  /// shops each having a TCK-000001 is correct, and a global counter would tell anyone who
  /// raised a ticket how many the whole platform has.
  ///
  /// Optional in the model because the column was added to a table that already had rows;
  /// every existing row was backfilled by the migration and every new one is given a number
  /// on creation.
  ticketNumber String? @map("ticket_number")

  createdByUserId String @map("created_by_user_id")
  createdByName   String @map("created_by_name")
  createdByEmail  String @map("created_by_email")

  subject  String
  category TicketCategory @default(OTHER)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  // Best-effort link to the ClientErrorLog row the reporter was looking at, if they raised
  // this ticket via a "Report this error" shortcut. No FK/relation on purpose -- an error
  // log entry is disposable data, and a dangling reference here must never block a ticket
  // from loading.
  linkedErrorId String? @map("linked_error_id")

  messages SupportTicketMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, ticketNumber], name: "uq_support_ticket_number")
  @@index([clientId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id       String        @id @default(uuid())
  ticketId String        @map("ticket_id")
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType String @map("author_type") // CLIENT | PLATFORM_ADMIN
  authorName String @map("author_name")
  body       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model InventoryAlert {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  type     InventoryAlertType
  severity InventoryAlertSeverity

  title   String
  message String

  variantId  String? @map("variant_id")
  locationId String? @map("location_id")

  currentQuantity Int? @map("current_quantity")
  threshold       Int?

  isRead     Boolean @default(false) @map("is_read")
  isResolved Boolean @default(false) @map("is_resolved")
  isPinned   Boolean @default(false) @map("is_pinned")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant  ProductVariant?      @relation(fields: [variantId], references: [id])
  location StockLocation?       @relation(fields: [locationId], references: [id])
  reads    InventoryAlertRead[]

  @@index([clientId])
  @@index([isResolved])
  @@index([isRead])
  @@index([isPinned])
  @@index([type])
  @@index([variantId])
  @@index([locationId])
  @@map("inventory_alerts")
}

model InventoryAlertRead {
  id      String @id @default(uuid())
  alertId String @map("alert_id")
  userId  String @map("user_id")

  readAt DateTime @default(now()) @map("read_at")

  alert InventoryAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId])
  @@map("inventory_alert_reads")
}

/// DEPRECATED -- superseded by StorefrontEvent below, and no longer written to.
///
/// It was a delivery queue with a single `status` column, which can only ever describe one
/// destination. That is why every row in it ended up stranded in 'PROCESSING': the dispatcher
/// claimed a batch, found no destination configured, and returned with the rows still claimed.
///
/// Left in place rather than reshaped because the deployed backend writes to it inside the
/// same transaction as every stock movement. Dropping or retyping its columns before that code
/// is replaced would fail every stock-in, stock-out and sale for every tenant until the deploy
/// completed. It stops growing once the new code ships and can be dropped in a later migration.
model InventoryEvent {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  eventType String @map("event_type")

  variantId  String @map("variant_id")
  locationId String @map("location_id")

  previousQuantity Int? @map("previous_quantity")
  quantity         Int

  available Boolean
  status    String  @default("PENDING") // PENDING or PROCESSED

  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  variant  ProductVariant @relation(fields: [variantId], references: [id])
  location StockLocation  @relation(fields: [locationId], references: [id])

  @@index([clientId])
  @@index([variantId])
  @@index([locationId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("inventory_events")
}

// ─── SIGNUP LEADS ───

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  REJECTED
}

/// A self-serve signup enquiry. Deliberately NOT a tenant: signing up creates no client, no
/// workspace, no login and no roles -- it only records that someone asked. The platform team
/// reviews the lead, contacts them, and converts it, which is the point at which the normal
/// onboarding runs and credentials are issued. Keeping the two apart means a public form can
/// never provision anything, so it cannot be used to spam real workspaces into existence.
model SignupLead {
  id String @id @default(uuid())

  companyName String  @map("company_name")
  contactName String  @map("contact_name")
  // Both required at signup -- the whole purpose of a lead is that someone can be reached.
  email       String
  phone       String
  message     String? @db.Text

  status LeadStatus @default(NEW)
  // Free-text working notes kept by whoever is handling the lead.
  notes  String?    @db.Text

  // Set when the lead is accepted and onboarded; links the enquiry to the workspace it
  // became, so the console can show the outcome rather than just "converted".
  convertedClientId String?   @map("converted_client_id")
  convertedAt       DateTime? @map("converted_at")

  // Kept for triage of abuse or duplicate submissions from the public form.
  sourceIp  String? @map("source_ip")
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Not unique: the same person legitimately enquires twice, and a unique index would let
  // an outsider probe which addresses are already known by watching for a rejection.
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("signup_leads")
}

/// Which supplier sells which item, and on what terms.
///
/// Nothing connected a product to a supplier before this: Supplier was referenced by
/// PurchaseOrder alone, so building a PO meant searching the whole catalogue with no
/// indication of what that supplier actually stocks, and questions like "who do we buy this
/// from" or "what is running low from this vendor" had no answer at all.
///
/// Many-to-many rather than a supplierId column on the variant, because the existing
/// purchase history already contains items bought from more than one supplier -- collapsing
/// that to a single source would discard real data and remove any ability to compare prices.
model SupplierProduct {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// The supplier's own code for this item, which is what appears on their invoice and is
  /// what they recognise on an order. PurchaseOrderItem has carried a supplierSku column
  /// since it was written but nothing ever populated it -- there was nowhere to source it
  /// from. This is that source.
  supplierSku String? @map("supplier_sku")

  /// What this supplier charges. Distinct from ProductVariant.averageCost (a weighted
  /// average of what was actually paid across every source) and from lastPurchaseCost
  /// (whatever the most recent receipt happened to cost) -- this is the agreed price with
  /// this vendor, which is what makes comparing suppliers possible.
  costPrice Decimal? @map("cost_price") @db.Decimal(18, 6)

  /// Days between placing an order and it arriving. Reordering at the reorder level assumes
  /// replenishment is instant; with a lead time the system can flag an item that will run
  /// out before a delivery could land.
  leadTimeDays Int? @map("lead_time_days")

  /// Smallest quantity this supplier will accept for this item.
  minOrderQty Int? @map("min_order_qty")

  /// The default source when an order is raised automatically. At most one per variant --
  /// enforced in the service, since a partial unique index is not expressible here.
  isPreferred Boolean @default(false) @map("is_preferred")

  notes String? @db.Text

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per supplier-item pair; re-linking updates the terms rather than duplicating.
  @@unique([supplierId, variantId], name: "uq_supplier_variant")
  @@index([clientId])
  @@index([variantId])
  @@index([supplierId])
  @@map("supplier_products")
}

// ─── SHOP SETTINGS ───

/// Per-shop configuration. There was no home for this at all: "General Info" in Settings is
/// the signed-in person's profile, not the business, so anything belonging to the shop had
/// nowhere to live.
///
/// Timezone is the reason it exists now. Everything is stored in UTC, which is right for
/// storage and wrong for a day book -- India runs 5.5 hours ahead, so a sale at 2am on the
/// 5th is 20:30 UTC on the 4th and a UTC-based daily report files it under the wrong date.
model ClientSettings {
  id       String @id @default(uuid())
  clientId String @unique @map("client_id")

  /// IANA zone, e.g. "Asia/Kolkata". Defines when the business day starts and ends.
  timezone String @default("Asia/Kolkata")

  /// The shop's own name, as opposed to the signed-in user's. Purchase orders sent on
  /// WhatsApp currently sign off with whoever happens to be logged in, because this did not
  /// exist anywhere.
  businessName String? @map("business_name")

  /// ISO code. Formatting stays in the frontend; this records the intent.
  currency String @default("INR")

  /// The most a person may take off by hand at the till, as a percentage of what is being
  /// discounted, without offer:manual_discount_unlimited. Null means no limit.
  manualDiscountMaxPercent Decimal? @map("manual_discount_max_percent") @db.Decimal(5, 2)

  /// The shop's logo, shown wherever the shop identifies itself to its own staff.
  ///
  /// Two fields rather than one because they answer different questions: logoUrl is what a
  /// browser loads, logoPath is which object in storage it is. Keeping the path means
  /// replacing or removing a logo can delete the file it replaces, instead of leaving every
  /// logo a shop has ever uploaded sitting in the bucket for ever.
  logoUrl  String? @map("logo_url")
  logoPath String? @map("logo_path")

  /// The rest of a letterhead: what a purchase order or goods receipt says about who sent it.
  /// All optional; an empty one is not printed.
  businessAddress String? @map("business_address")
  businessPhone   String? @map("business_phone")
  businessEmail   String? @map("business_email")
  gstNumber       String? @map("gst_number")

  /// Printed at the bottom of a counter receipt: "Exchange within 7 days".
  receiptFooter String? @map("receipt_footer")

  /// Days after a sale in which a return is accepted at the counter without a manager. Null: any time.
  returnWindowDays Int?     @map("return_window_days")
  /// The most a salesperson may pay back on one counter return without a manager. Null: no limit.
  counterReturnMax Decimal? @map("counter_return_max") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("client_settings")
}

/// Money taken for an order, or paid back. One row per method: a split payment is several rows.
///
/// "Paid", "X due" and "Refunded" are worked out from these rows and never stored a second time,
/// so the two can never disagree. Amounts are exact to the paisa, like every price here.
///
/// `reference` is what a person needs to find the payment again -- a UPI transaction id, the last
/// four digits of a card or its approval code. Never a card number: the service refuses one.
model SalesOrderPayment {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  kind   PaymentKind   @default(PAYMENT)
  method PaymentMethod

  /// What went against the order. For cash, what was kept -- not what was handed over.
  amount       Decimal  @db.Decimal(10, 2)
  /// Cash only: the note(s) handed over, and what was given back.
  cashReceived Decimal? @map("cash_received") @db.Decimal(10, 2)
  changeGiven  Decimal? @map("change_given") @db.Decimal(10, 2)
  reference    String?

  /// For a refund, the return it pays back.
  salesReturnId String?      @map("sales_return_id")
  salesReturn   SalesReturn? @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)

  receivedById String? @map("received_by_id")
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now()) @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([clientId, receivedAt])
  @@index([salesOrderId])
  @@index([locationId, receivedAt])
  @@index([salesReturnId])
  @@index([receivedById])
  @@map("sales_order_payments")
}

/// End-of-day stock per LOCATION, alongside the company-wide DailyInventorySnapshot.
///
/// Kept separate rather than adding a locationId to that table, because the company-wide row
/// carries figures that do not divide by location at all -- open purchase order value and
/// active product count belong to the business, not to a warehouse. Mixing them would mean
/// either duplicating those numbers against every location or leaving them null on most rows.
///
/// This is what makes a transfer legible: moving 40 units from warehouse to store changes
/// both locations while leaving the company total untouched. Without a per-location record
/// that movement is invisible in the daily figures.
model DailyLocationSnapshot {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  locationId String        @map("location_id")
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  snapshotDate DateTime @map("snapshot_date")
  totalUnits   Int      @default(0) @map("total_units")
  totalValue   Decimal  @default(0) @map("total_value") @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([locationId, snapshotDate], name: "uq_location_snapshot_day")
  @@index([clientId, snapshotDate])
  @@map("inventory_daily_location_snapshots")
}

// ─── STOREFRONT INTEGRATION ───
//
// Three concerns, deliberately three tables, because collapsing any two of them is what broke
// the previous attempt:
//
//   InventoryTransaction  what happened to stock -- the audit record, and the source of truth
//   StorefrontEvent       what a storefront needs to be told -- immutable, ordered
//   StorefrontDelivery    whether one particular storefront has been told -- per connection
//
// Inventory is authoritative and a storefront is a projection of it. Nothing here ever accepts
// a storefront's opinion about stock, price or publication state.

enum StorefrontEventType {
  STOCK_UPDATED
  PRODUCT_PUBLISHED
  PRODUCT_UPDATED
  PRODUCT_UNPUBLISHED
  PRICE_CHANGED
  AVAILABILITY_CHANGED
}

/// What a storefront needs to be told, stated once and never edited.
///
/// Carries ABSOLUTE state, never a delta. "available = 6" is a statement of truth that any
/// number of retries or reorderings cannot corrupt; "decrease by 1" compounds every time it is
/// redelivered. This is what makes duplicate delivery a no-op rather than a corruption, and it
/// is why the delivery guarantees below can stay simple.
///
/// It holds no delivery state at all -- see StorefrontDelivery.
model StorefrontEvent {
  id String @id @default(uuid())

  /// Monotonic per tenant. A receiver applies last-writer-wins on this and discards anything
  /// older than it has already applied for that entity, so out-of-order arrival is
  /// self-correcting. Timestamps cannot do this: two events in the same millisecond are
  /// unordered, and clocks move.
  sequence BigInt @default(autoincrement())

  clientId String @map("client_id")

  eventType    StorefrontEventType @map("event_type")
  /// Part of the public contract. Old integrations must not break when `payload` grows.
  eventVersion Int                 @default(1) @map("event_version")

  /// What the event is about, by PUBLIC identity. SKU and product code are stable, unique per
  /// tenant and meaningful to a merchant; internal uuids would couple every storefront's
  /// database to our primary keys.
  productCode String? @map("product_code")
  sku         String?

  variantId  String? @map("variant_id")
  locationId String? @map("location_id")

  /// The event body as it will be sent, minus the envelope. Rendered at write time from the
  /// same catalogue rules the read API uses, so a storefront cannot receive a shape the API
  /// would not have given it.
  payload Json

  createdAt DateTime @default(now()) @map("created_at")

  deliveries StorefrontDelivery[]

  @@index([clientId, sequence])
  @@index([clientId, createdAt])
  @@index([eventType])
  @@map("storefront_events")
}

enum StorefrontConnectionType {
  GENERIC
  SHOPIFY
  WOOCOMMERCE
}

enum StorefrontConnectionStatus {
  /// Created but has not completed its first catalogue sync. Events are queued rather than
  /// sent: telling a storefront that a price changed is meaningless before it has the product.
  PENDING_SYNC
  ACTIVE
  DISABLED
  /// Terminal. The credential can never be used again; the row survives for its history.
  REVOKED
}

/// One storefront a shop has connected.
///
/// A shop may have several -- a website, a marketplace, a staging site -- each with its own
/// credential, its own location scope and its own delivery history, so one can fail, be paused
/// or be revoked without touching the others.
model StorefrontConnection {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  name    String
  type    StorefrontConnectionType   @default(GENERIC)
  status  StorefrontConnectionStatus @default(PENDING_SYNC)
  baseUrl String                     @map("base_url")

  /// The secret is shown once at creation and never stored. Only its hash is kept, so a leak
  /// of this table does not hand anyone the ability to impersonate us to a merchant.
  credentialHash   String @map("credential_hash")
  /// A short, non-secret prefix so a credential can be named in the UI and in logs without
  /// printing anything usable.
  credentialPrefix String @map("credential_prefix")

  /// Which locations this storefront sells from. Empty means all of them.
  ///
  /// Not optional in this product: VariantLocationProfile carries isAvailable AND priceOverride
  /// per location, so stock and price are both properties of a variant AT a location. A
  /// merchant with a back-office warehouse and a shop has no single answer to "what does the
  /// website show" -- without this the integration guesses, and publishes warehouse stock or a
  /// shop-floor price override to the public web.
  locationIds String[] @map("location_ids")

  /// Where the initial catalogue sync has reached, so an interruption resumes instead of
  /// restarting -- a merchant with 8,000 variants cannot be asked to start again at 7,900.
  syncCursor     String?   @map("sync_cursor")
  syncedAt       DateTime? @map("synced_at")
  lastDeliveryAt DateTime? @map("last_delivery_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries StorefrontDelivery[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([credentialPrefix])
  @@map("storefront_connections")
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRYING
  /// Given up on after the retry budget. Kept, and re-queueable by hand from the log.
  DEAD_LETTER
  /// The connection was disabled or revoked while this was waiting. Neither side failed, and
  /// it must never be retried.
  CANCELLED
}

/// Whether one particular storefront has been told about one particular event.
///
/// Holds references and delivery state, never a copy of the payload: the body is rendered from
/// the event at send time, so a rotated secret or a changed URL applies to work already queued.
model StorefrontDelivery {
  id           String @id @default(uuid())
  eventId      String @map("event_id")
  connectionId String @map("connection_id")
  /// Denormalised so the queue can be made fair per tenant without a join.
  clientId     String @map("client_id")

  status   DeliveryStatus @default(PENDING)
  attempts Int            @default(0)

  nextAttemptAt DateTime? @map("next_attempt_at")
  lastAttemptAt DateTime? @map("last_attempt_at")
  /// When a worker claimed this row. A claim older than the lease means the process died
  /// mid-send; it is reclaimed rather than stranded, which is the failure that left every row
  /// of the previous outbox stuck forever.
  lockedAt      DateTime? @map("locked_at")

  lastResponseStatus Int?      @map("last_response_status")
  lastError          String?   @map("last_error")
  lastDurationMs     Int?      @map("last_duration_ms")
  deliveredAt        DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")

  event      StorefrontEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  connection StorefrontConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// One delivery per event per connection, enforced rather than assumed.
  @@unique([eventId, connectionId], name: "uq_delivery_event_connection")
  @@index([status, nextAttemptAt])
  @@index([clientId, status])
  @@index([connectionId, createdAt])
  @@map("storefront_deliveries")
}

// =============================================================================
// SHOPIFY
// =============================================================================
//
// Shopify inverts the generic storefront contract in every direction, which is why it needs
// tables of its own rather than more columns on StorefrontConnection:
//
//   generic    we POST to a URL the merchant gave us, holding a one-way HASH we only verify
//   Shopify    we CALL Shopify's Admin API, holding a token we must REPLAY on every request
//
// A hash cannot be replayed. That single fact is why credentialHash is left alone here and the
// token lives encrypted, reversibly, in a column of its own.

/// Where an install came from, because the two directions have different security properties.
enum ShopifyInstallSource {
  /// The merchant was already signed in to ScaleEzy and pressed Connect, so the tenant is
  /// known before OAuth begins and the installation is bound on arrival.
  SCALEEZY
  /// The install began on Shopify's side -- a listing, a link, a partner recommendation -- so
  /// the callback arrives with a shop domain and NO idea which tenant it belongs to. It is
  /// parked unclaimed and syncs nothing until a signed-in merchant claims it.
  SHOPIFY
}

/// One Shopify store that has installed the app.
///
/// Separate from StorefrontConnection because the lifecycles genuinely differ: a shop can be
/// installed but unclaimed (nobody knows whose it is yet), and a connection can be paused
/// without the app being uninstalled.
model ShopifyInstallation {
  id String @id @default(uuid())

  /// e.g. "my-store.myshopify.com". The stable identity Shopify uses everywhere; the
  /// merchant-facing store name can change, this cannot.
  shopDomain    String  @unique @map("shop_domain")
  /// Shopify's own numeric id for the shop, read on the first API call. Survives a rename.
  shopifyShopId String? @map("shopify_shop_id")

  /// Null until claimed. An unclaimed installation is inert: no sync, no delivery, nothing
  /// leaves ScaleEzy -- because we do not yet know whose data it would be.
  clientId String? @map("client_id")

  source ShopifyInstallSource @default(SCALEEZY)

  /// AES-256-GCM via lib/credentialEncryption. Deliberately NOT hashed: every Admin API call
  /// replays this. Never returned to a browser, never logged, never sent to the frontend.
  accessTokenEncrypted  String    @map("access_token_encrypted")
  /// Offline tokens now expire after an hour and are renewed with a refresh token, which
  /// itself rotates on every use. Public apps must use expiring tokens for GraphQL Admin
  /// requests, so a permanent token is not something to design around.
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  /// What Shopify actually granted, which is not necessarily what was asked for -- a merchant
  /// can decline scopes. Checked before any operation that depends on one.
  scopes String

  installedAt   DateTime  @default(now()) @map("installed_at")
  uninstalledAt DateTime? @map("uninstalled_at")
  claimedAt     DateTime? @map("claimed_at")
  claimedByUser String?   @map("claimed_by_user")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  idMap        ShopifyIdMap[]
  locationMap  ShopifyLocationMap[]
  offerMirrors OfferExternalMirror[]
  echoes       ShopifyInventoryEcho[]

  @@index([clientId])
  @@index([uninstalledAt])
  @@map("shopify_installations")
}

/// Our variant, and Shopify's ids for the same thing.
///
/// Without this every push is a search by SKU, and a create that timed out and was retried
/// produces a second product. Shopify's own ids are the only safe way to say "update THAT one".
model ShopifyIdMap {
  id             String @id @default(uuid())
  installationId String @map("installation_id")
  clientId       String @map("client_id")

  /// Ours.
  variantId String @map("variant_id")
  sku       String

  /// Theirs. inventoryItemId is separate from the variant id because inventory is set against
  /// the inventory item, not the variant -- a distinction that is easy to miss and produces
  /// "not found" errors that read like a permissions problem.
  shopifyProductId       String  @map("shopify_product_id")
  shopifyVariantId       String  @map("shopify_variant_id")
  shopifyInventoryItemId String? @map("shopify_inventory_item_id")

  /// MATCHED when an existing Shopify variant was adopted by SKU, CREATED when we made it.
  /// Kept because "we created this" is what makes a destructive change safe, and adoption of
  /// something the merchant built by hand is not.
  origin String @default("MATCHED")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  installation ShopifyInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, variantId], name: "uq_shopify_map_variant")
  @@unique([installationId, shopifyVariantId], name: "uq_shopify_map_shopify_variant")
  @@index([clientId])
  @@index([installationId, sku])
  @@map("shopify_id_maps")
}

/// Our StockLocation, and the Shopify Location the merchant paired it with.
///
/// Never inferred. Guessing here publishes back-office warehouse stock to the public web.
model ShopifyLocationMap {
  id             String @id @default(uuid())
  installationId String @map("installation_id")
  clientId       String @map("client_id")

  locationId        String @map("location_id")
  shopifyLocationId String @map("shopify_location_id")

  createdAt DateTime @default(now()) @map("created_at")

  installation ShopifyInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, locationId], name: "uq_shopify_location_ours")
  @@unique([installationId, shopifyLocationId], name: "uq_shopify_location_theirs")
  @@index([clientId])
  @@map("shopify_location_maps")
}

/// Every inbound Shopify webhook, recorded before it is acted on.
///
/// Shopify delivers the same webhook more than once by design, so an order must not be
/// ingested twice -- the unique key is what makes that structural rather than hopeful.
model ShopifyWebhookReceipt {
  id String @id @default(uuid())

  /// Shopify's X-Shopify-Webhook-Id, stable across redeliveries of the same event.
  webhookId  String @map("webhook_id")
  topic      String
  shopDomain String @map("shop_domain")

  processedAt DateTime? @map("processed_at")
  /// APPLIED | DUPLICATE | ECHO | IGNORED | FAILED
  outcome     String?
  error       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([webhookId, topic], name: "uq_shopify_webhook")
  @@index([shopDomain, createdAt])
  @@map("shopify_webhook_receipts")
}

/// A privacy request Shopify sent -- customers/data_request, customers/redact or shop/redact --
/// and what was done about it.
///
/// Identifiers and counts only, never a copy of the personal data: a data request is answered by
/// reading what is held at the moment the merchant exports it.
model ShopifyPrivacyRequest {
  id String @id @default(uuid())

  shopDomain String  @map("shop_domain")
  /// Null while the store is unclaimed; filled in when somebody claims it.
  clientId   String? @map("client_id")
  topic      String
  webhookId  String  @map("webhook_id")

  shopifyCustomerId String?  @map("shopify_customer_id")
  /// data_request.id from the payload, for quoting back to Shopify support.
  shopifyRequestId  String?  @map("shopify_request_id")
  /// orders_requested / orders_to_redact.
  shopifyOrderIds   String[] @default([]) @map("shopify_order_ids")

  /// RECEIVED | WAITING_FOR_MERCHANT | COMPLETED | SKIPPED | FAILED
  status  String
  /// Counts of what was found or changed. No personal data.
  summary Json?
  detail  String? @db.Text

  completedAt DateTime? @map("completed_at")
  exportedAt  DateTime? @map("exported_at")
  exportedBy  String?   @map("exported_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([webhookId, topic], name: "uq_privacy_request_webhook")
  @@index([clientId, createdAt])
  @@index([shopDomain, createdAt])
  @@map("shopify_privacy_requests")
}

/// The last inventory value WE wrote to Shopify, per item per location.
///
/// This is the echo-loop cure. We set Shopify to 25; Shopify dutifully fires
/// inventory_levels/update saying 25; without this we read that as a merchant change, correct
/// ourselves, raise an event, and push again -- forever. A webhook whose value matches what we
/// last wrote is our own voice coming back, and is dropped. Anything else is a real external
/// change and is surfaced rather than silently applied, because ScaleEzy is the authority.
///
/// A time window alone cannot do this: Shopify webhooks can arrive minutes late under load.
model ShopifyInventoryEcho {
  id             String @id @default(uuid())
  installationId String @map("installation_id")

  shopifyInventoryItemId String @map("shopify_inventory_item_id")
  shopifyLocationId      String @map("shopify_location_id")

  quantity  Int
  writtenAt DateTime @default(now()) @map("written_at")

  installation ShopifyInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, shopifyInventoryItemId, shopifyLocationId], name: "uq_shopify_echo")
  @@map("shopify_inventory_echoes")
}

/// A pending OAuth install, held server-side between the redirect out and the callback back.
///
/// Shopify's guide suggests keeping the `state` nonce in a signed cookie. A row is stronger and
/// solves a second problem at the same time:
///
///   1. it proves the callback belongs to an install WE started, which a cookie also does; and
///   2. it carries the ScaleEzy clientId across the round trip WITHOUT the browser holding it.
///
/// The second matters. The tenant a shop gets bound to decides whose inventory is published to
/// that storefront. If that binding travelled through the browser, anyone able to edit a cookie
/// could attach their own Shopify store to somebody else's tenant, or somebody else's store to
/// theirs. Here the browser carries only an opaque nonce, and the binding is read from a row it
/// cannot reach.
///
/// Rows are single-use and short-lived: consumed on the callback, and expired otherwise, so a
/// nonce captured from a browser's history cannot be replayed later.
model ShopifyOAuthState {
  id String @id @default(uuid())

  /// The opaque value sent to Shopify as `state` and compared on the way back.
  nonce String @unique

  /// Which shop this install is for. Compared against the `shop` Shopify returns -- a callback
  /// that quotes our nonce but a different shop is an attempt to redirect the binding.
  shopDomain String @map("shop_domain")

  /// Null for an install that began on Shopify's side, where no tenant is known yet.
  clientId      String? @map("client_id")
  /// Who pressed Connect, for the audit trail of who bound this shop to this tenant.
  startedByUser String? @map("started_by_user")

  /// Set when the callback consumes it. A second callback with the same nonce is a replay and
  /// is refused rather than quietly creating a second installation.
  consumedAt DateTime? @map("consumed_at")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("shopify_oauth_states")
}

/// Which platform service a stored key is for.
///
/// An enum rather than a free string so that adding a service is a deliberate change with a
/// migration behind it, and a typo cannot quietly create a second, parallel "catalog_tryon".
enum ClientService {
  /// 4-View Catalog Try-On. The merchant's own tool: one garment photograph in, four catalogue
  /// views out. Used from inside the app, by staff, on products they are listing.
  CATALOG_TRYON

  /// Try-On. The shopper's tool, reached by scanning the QR code on a product: they upload a
  /// photograph of themselves and see themselves in the garment.
  ///
  /// A separate gateway service with its own key per client, not a second use of the catalog
  /// key. The two are metered differently and priced differently, and a shop could reasonably
  /// have one and not the other -- which is impossible if they share a credential.
  SHOPPER_TRYON
}

/// A client's key for a platform service, issued by the gateway and pasted in by an admin.
///
/// The gateway owns identity, quota and metering. This is a copy held so the inventory module
/// can present the key on that client's behalf -- one place a key is issued, one place it is
/// revoked, and this is neither.
///
/// ENCRYPTED, NOT HASHED, for the same reason as the Shopify token: it is replayed on every
/// call, so it has to come back out. That does mean this table holds replayable secrets and is
/// worth more to an attacker than most. It is mitigated by never returning the value from any
/// merchant-facing endpoint -- only keyPrefix leaves the building -- and by the gateway being
/// able to revoke a key without us.
model ClientServiceCredential {
  id       String        @id @default(uuid())
  clientId String        @map("client_id")
  service  ClientService

  /// AES-256-GCM via lib/credentialEncryption.
  keyEncrypted String @map("key_encrypted")
  /// The first few characters, kept in clear. Enough for a merchant to recognise their key in
  /// a support conversation and for a log line to be useful, and useless on its own.
  keyPrefix    String @map("key_prefix")

  status ClientServiceCredentialStatus @default(ACTIVE)

  /// Who pasted it, and when. This is a platform admin acting on a client's account, so it
  /// belongs in an audit trail rather than only in a log file.
  addedByAdmin String   @map("added_by_admin")
  addedAt      DateTime @default(now()) @map("added_at")

  /// Set on every successful use, so a key nobody is using is visible as such.
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  /// One key per service per client. Replacing one updates this row rather than accumulating
  /// rows nobody can tell apart.
  @@unique([clientId, service], name: "uq_client_service_key")
  @@index([clientId])
  @@map("client_service_credentials")
}

enum ClientServiceCredentialStatus {
  ACTIVE
  REVOKED
}

/// One row per client per day of try-on usage.
///
/// An aggregate, not a log. The gateway's RequestLog already records every call and is the
/// right thing for debugging one; it is the wrong thing for "how many generations did this
/// shop use in September", which gets slower every month and stops working entirely once logs
/// are pruned. This table answers that in one read and stays the same size per client per day.
///
/// Outcomes are counted separately rather than as one total, because they are not the same
/// commercially. A generation that failed halfway used GPU time but produced nothing a
/// merchant can sell from; one they cancelled may have used none. Billing on "requests" would
/// charge for all three identically, and charge twice for a timeout retry.
model TryOnUsage {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// Which try-on. Defaulted to CATALOG_TRYON so every row written before shopper try-on
  /// existed keeps meaning what it meant -- there was only one service to be.
  ///
  /// The uniqueness below had to widen with it. Without the service in the key, a shop's two
  /// try-ons would collide on the same day row and increment each other's counters, which is
  /// worse than losing the split: it would silently overbill one against the other.
  service ClientService @default(CATALOG_TRYON)

  /// The shop's own business day, "YYYY-MM-DD", not UTC -- so a day's usage matches the day
  /// the merchant experienced, the same rule the day book uses.
  day String

  /// Attempts that reached the gateway.
  started   Int @default(0)
  /// Streams that ran to completion.
  completed Int @default(0)
  /// Started and then failed -- the gateway refused, or the stream broke.
  failed    Int @default(0)
  /// The merchant navigated away or pressed stop.
  cancelled Int @default(0)

  /// Views actually produced, when the stream says so. NOT four times `completed`: a run that
  /// yields three of four views is a real outcome and is recorded as three rather than rounded
  /// up to a full generation's worth.
  viewsGenerated Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, service, day], name: "uq_tryon_usage_day")
  @@index([clientId, service, day])
  @@map("tryon_usage")
}

/// A client's monthly allowance for a service.
///
/// Separate from ClientServiceCredential because a limit has to be settable for a client who
/// has no key of their own -- which is every client today, since they all share the platform
/// key. Tying the allowance to the key would mean the clients most likely to run away with
/// usage are exactly the ones that cannot be capped.
///
/// Try-on is GPU work, so an unmetered client is real money rather than just load. The absence
/// of a row means no limit, which is the right default for a platform that already has
/// customers -- but the console should make an unlimited client visible rather than quiet.
model ClientServiceLimit {
  id       String        @id @default(uuid())
  clientId String        @map("client_id")
  service  ClientService

  /// Generations per calendar month. Null is unlimited.
  monthlyLimit Int? @map("monthly_limit")

  updatedByAdmin String   @map("updated_by_admin")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([clientId, service], name: "uq_client_service_limit")
  @@map("client_service_limits")
}

// ─── QUARANTINED: WHATSAPP DAILY REPORT ──────────────────────────────────────
//
// These three declarations describe tables that EXIST IN PRODUCTION but whose code does
// not exist in this repository. They were found on 12 Sep 2026 while verifying the
// migration baseline: `migrate diff` between the live database and this schema proposed
// dropping two tables, an enum and two user columns -- a live feature with real data
// (6 jobs, 3 deliveries, 3 users opted in with phone numbers).
//
// They are declared here for ONE reason: so that Prisma no longer sees them as drift.
// Without this, the next `migrate dev` would generate DROP TABLE for a running feature
// and take three users' notification settings with it.
//
// This is quarantine, not adoption. Nothing in this repo reads or writes these tables,
// and no service class, route or job here refers to them. Whoever owns the WhatsApp daily
// report should either bring its code into this repository -- at which point these become
// ordinary models and this comment goes -- or retire the feature and drop the tables in a
// deliberate migration. Until one of those happens, leave them alone.
//
// Field names and types are exactly as introspected from production, so this schema
// describes what is really there rather than what we would have designed.

enum ReportDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model DailyReportJob {
  id String @id

  clientId   String @map("client_id")
  reportDate String @map("report_date")

  status      String    @default("IN_PROGRESS")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  deliveries DailyReportDelivery[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, reportDate])
  @@index([clientId, reportDate])
  @@map("daily_report_jobs")
}

model DailyReportDelivery {
  id String @id

  jobId String         @map("job_id")
  job   DailyReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  clientId String @map("client_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportDate String @map("report_date")
  phone      String

  status       ReportDeliveryStatus @default(PENDING)
  errorMessage String?              @map("error_message")
  sentAt       DateTime?            @map("sent_at")
  attemptedAt  DateTime?            @map("attempted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One message per user per day -- the constraint that stops a retry double-messaging.
  @@unique([reportDate, userId])
  @@index([clientId, reportDate])
  @@index([jobId])
  @@map("daily_report_deliveries")
}

// =============================================================================
// OFFERS
// =============================================================================
//
// One place a merchant writes a discount, whichever storefront it sells through.
//
// A shop running a Deepavali sale types it once. The till and the shop's own website apply it
// because they ASK us what a basket costs; Shopify applies it because we push a copy into
// Shopify, which owns its own checkout and cannot be made to ask. That difference is why Offer
// is the source of truth and never the mirror.
//
// Nothing here APPLIES an offer. Phase 2 is authoring; the engine that prices a basket is
// Phase 3 and reads these tables.

enum OfferStatus {
  /// Being written. Never applies to anything.
  DRAFT
  ACTIVE
  /// Switched off by hand, keeping its dates. Distinct from EXPIRED, which time did.
  PAUSED
  EXPIRED
  /// Finished with. Kept, because orders point at its versions.
  ARCHIVED
}

enum OfferTrigger {
  /// Applies on its own, to any basket that qualifies.
  AUTOMATIC
  /// Applies only when the customer gives the code.
  CODE
}

enum OfferValueType {
  PERCENTAGE
  FIXED_AMOUNT
  /// "This, for 999" -- a price, not a reduction.
  FIXED_PRICE
}

enum OfferScope {
  ALL
  /// A department: WOMEN, MEN, KIDS, UNISEX -- Product.category.
  CATEGORY
  /// What a shop calls a kind of garment: Saree, Lehenga, Anarkali -- Product.dressType. This is what
  /// a merchant means by "20% off sarees"; the department alone cannot say it.
  DRESS_TYPE
  PRODUCT
  VARIANT
}

enum OfferLevel {
  /// Comes off the matching lines.
  LINE
  /// Comes off the basket, then divided between the lines.
  ORDER
}

/// A rule a merchant wrote.
model Offer {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// OFR-000001. Ours, sequential, and shown to the merchant.
  offerCode String @map("offer_code")

  /// What the merchant typed. It reaches the customer on a receipt, so it is a label rather than
  /// an internal name.
  name        String
  description String? @db.Text

  trigger OfferTrigger @default(AUTOMATIC)

  /// Only when trigger = CODE. Matched case-insensitively; stored as typed.
  couponCode String? @map("coupon_code")

  level     OfferLevel     @default(LINE)
  valueType OfferValueType @map("value_type")
  value     Decimal        @db.Decimal(10, 2)

  /// A ceiling on a percentage. "20% off, up to 2,000" is the shape every shop asks for, and the
  /// one that stops a percentage running away on an unusually large basket.
  maxDiscount Decimal? @map("max_discount") @db.Decimal(10, 2)

  scope   OfferScope    @default(ALL)
  targets OfferTarget[]

  /// Conditions on the basket. Null means no condition, which is not the same as zero.
  minSubtotal Decimal? @map("min_subtotal") @db.Decimal(10, 2)
  minQuantity Int?     @map("min_quantity")

  /// Where it applies. Empty means everywhere -- the same convention StorefrontConnection uses for
  /// locationIds, so a merchant meets one idea rather than two.
  channels    SalesChannel[]
  locationIds String[]       @map("location_ids")

  /// INCLUSIVE. Stored UTC, entered and shown in the shop's own timezone.
  startsAt DateTime @map("starts_at")

  /// EXCLUSIVE, and null means open-ended. An offer "ending 30 Sep" is stored as 1 Oct 00:00 and
  /// shown as "ends 30 Sep, 11:59 pm", so a merchant never has to reason about which it is.
  endsAt DateTime? @map("ends_at")

  usageLimit            Int? @map("usage_limit")
  usageLimitPerCustomer Int? @map("usage_limit_per_customer")

  /// Maintained as orders redeem it. A counter rather than a count(*), because the limit has to be
  /// checkable inside the same transaction that takes the order.
  usageCount Int @default(0) @map("usage_count")

  /// Higher wins when two offers compete for the same line.
  priority Int @default(0)

  /// Whether it can apply on top of another. Non-stackable offers compete and only the best one
  /// applies -- the same rule Shopify uses, so ours and theirs agree by default rather than by
  /// accident.
  stackable Boolean @default(false)

  /// FIXED_AMOUNT on items only: true takes the amount off every piece ("200 off each saree"),
  /// false once off each line however many pieces are on it.
  perPiece Boolean @default(false) @map("per_piece")

  /// Only customers carrying one of these tags (VIP, STAFF...). Empty means every customer.
  customerTags String[] @default([]) @map("customer_tags")

  /// Happy hours, in the shop's own timezone: {"days":[1,2,3,4,5],"from":"16:00","to":"19:00"}.
  /// Null means whenever the offer is running.
  schedule Json?

  /// A CODE offer unlocked by single-use codes in OfferCode rather than one shared couponCode.
  uniqueCodes Boolean @default(false) @map("unique_codes")

  exclusions OfferExclusion[]
  codes      OfferCode[]

  status OfferStatus @default(DRAFT)

  /// The version an order records when it redeems this.
  currentVersionId String? @map("current_version_id")

  versions    OfferVersion[]
  redemptions OfferRedemption[]
  mirrors     OfferExternalMirror[]

  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@unique([clientId, offerCode])
  /// One live code per shop. Two offers answering to DEEPAVALI is a question with no right answer.
  @@unique([clientId, couponCode])
  @@index([clientId, status, startsAt, endsAt])
  @@map("offers")
}

/// What an offer applies to, when it does not apply to everything.
/// What an offer leaves out: "everything except bridal lehengas". Any scope but ALL, whatever the
/// offer itself applies to.
model OfferExclusion {
  id      String @id @default(uuid())
  offerId String @map("offer_id")
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  scope OfferScope
  refId String     @map("ref_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([offerId, scope, refId])
  @@index([offerId])
  @@map("offer_exclusions")
}

/// One single-use code. Spent inside the transaction that writes the order, given back if that
/// order is cancelled before it ships -- the same life as an offer's allowance.
model OfferCode {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  offerId  String @map("offer_id")
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// Stored upper-case; matched upper-case.
  code String

  salesOrderId String?   @map("sales_order_id")
  usedAt       DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, code])
  @@index([offerId])
  @@index([salesOrderId])
  @@map("offer_codes")
}

model OfferTarget {
  id      String @id @default(uuid())
  offerId String @map("offer_id")
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  scope OfferScope

  /// A category name, a productId or a variantId, according to `scope`. Deliberately not a foreign
  /// key: a category is not a row, and an offer has to survive a product being trashed.
  refId String @map("ref_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([offerId, scope, refId])
  @@index([offerId])
  @@map("offer_targets")
}

/// What the rule said, at a moment. Immutable.
///
/// This is what lets an order explain itself six months later. An order records a VERSION, not the
/// offer, so editing "20% off" down to "10% off" in November cannot rewrite what October's
/// customers were charged -- which is exactly what happens when a report joins to a mutable rule.
model OfferVersion {
  id      String @id @default(uuid())
  offerId String @map("offer_id")
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  version Int

  /// The whole rule as it stood. Json rather than a copy of every column, because the shape of an
  /// offer will grow and an old version must still read correctly when it does.
  snapshot Json

  changedBy  String? @map("changed_by")
  changeNote String? @map("change_note")

  createdAt DateTime @default(now()) @map("created_at")

  redemptions OfferRedemption[]

  @@unique([offerId, version])
  @@index([offerId])
  @@map("offer_versions")
}

/// One order that used one offer.
///
/// Separate from SalesOrderDiscount, which records what came OFF. This records that the offer's
/// allowance was SPENT. They are the same event seen from two ends, and the limits have to be
/// counted from this side because an order can be cancelled and give its allowance back.
model OfferRedemption {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  offerId        String       @map("offer_id")
  offer          Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerVersionId String       @map("offer_version_id")
  offerVersion   OfferVersion @relation(fields: [offerVersionId], references: [id], onDelete: Restrict)

  salesOrderId String  @map("sales_order_id")
  customerId   String? @map("customer_id")

  amount Decimal @db.Decimal(10, 2)

  /// COUNTED | RELEASED. An order cancelled before it shipped gives the allowance back; a return
  /// does not, which matches Shopify and stops refund-and-reuse.
  status String @default("COUNTED")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// An offer counts once per order, however many lines it touched.
  @@unique([offerId, salesOrderId], name: "uq_redemption_offer_order")
  @@index([clientId, offerId])
  @@index([salesOrderId])
  @@index([customerId])
  @@map("offer_redemptions")
}

/// One offer, copied into one connected Shopify store.
///
/// Shopify owns its checkout and cannot be made to ask our pricing engine, so for Shopify we push a
/// COPY of the rule and then keep checking that the copy still says what we pushed. This row is
/// both the record of that copy and the unit of work that keeps it true: it carries its own
/// attempts, backoff and lease, the same pattern StorefrontDelivery uses, because a push is absolute
/// state -- "this discount should look like this" -- and a retry of absolute state cannot corrupt.
///
/// Two hashes, because two different questions get asked:
///
///   pushedHash   what we last successfully told Shopify
///   remoteHash   what Shopify held the last time we looked
///
/// Drift is Shopify holding something that is neither what we pushed nor what the offer says now.
model OfferExternalMirror {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  offerId String @map("offer_id")
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  installationId String              @map("installation_id")
  installation   ShopifyInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  /// Shopify's GID for the discount we created. The guard against creating a second one on retry.
  shopifyDiscountId String? @map("shopify_discount_id")
  /// AUTOMATIC | CODE -- what the Shopify discount IS. An offer switched between the two cannot be
  /// updated in place; the old one is removed and a new one created.
  kind              String?

  pushedHash String? @map("pushed_hash")
  remoteHash String? @map("remote_hash")

  /// PENDING | SYNCED | DRIFTED | FAILED | UNSUPPORTED | REMOVING
  status String @default("PENDING")

  /// What a merchant is told: why it cannot be expressed, what failed, what changed in Shopify.
  problem String? @db.Text

  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lockedAt      DateTime? @map("locked_at")

  lastPushedAt  DateTime? @map("last_pushed_at")
  lastCheckedAt DateTime? @map("last_checked_at")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([offerId, installationId], name: "uq_mirror_offer_installation")
  @@index([status, nextAttemptAt])
  @@index([clientId])
  @@index([shopifyDiscountId])
  @@map("offer_external_mirrors")
}

/// A price we quoted, kept so an order can be held to it.
///
/// Without this an offer that ends at midnight prices a basket at 23:59:58 and charges a different
/// amount when the customer presses pay at 00:00:03. The customer saw a number; charging more is
/// not acceptable, and re-pricing at order time is exactly how that happens.
///
/// So the quote is frozen and short-lived. Fifteen minutes is long enough for a checkout and short
/// enough that an expired sale is not honoured for hours.
model PricingQuote {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  locationId String       @map("location_id")
  channel    SalesChannel
  customerId String?      @map("customer_id")

  /// A fingerprint of what was asked: the lines, the codes, the location. An order that arrives
  /// with a different basket than the one quoted must not be given the quoted price, and this is
  /// what makes that checkable rather than assumed.
  inputHash String @map("input_hash")

  /// The whole priced result, as it was shown. Json rather than columns: this is a record of what
  /// somebody was told, and it must still read correctly when the shape of a quote grows.
  result Json

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  expiresAt DateTime @map("expires_at")

  /// Set when an order was actually written against it. A quote is good once -- otherwise one
  /// checkout's price could be replayed onto ten orders.
  consumedAt   DateTime? @map("consumed_at")
  salesOrderId String?   @map("sales_order_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, expiresAt])
  @@index([salesOrderId])
  @@map("pricing_quotes")
}

// =============================================================================
// WHATSAPP
// =============================================================================
//
// Inventory's side of WhatsApp. The numbers, the send queue and the engine live in the separate
// ScaleEzy WhatsApp Service (D:\villy\whatsapp-service); this keeps only what the shop's screens
// need: its nightly Day Book choice, and what was sent from here with where it has got to.

/// One row per shop, created the first time the owner saves a WhatsApp choice.
model WhatsAppSettings {
  clientId String @id @map("client_id")

  /// The nightly Day Book, sent from the ScaleEzy number to the owner. Off until switched on.
  dayBookEnabled     Boolean @default(false) @map("day_book_enabled")
  /// "HH:MM", the shop's own time (ClientSettings.timezone).
  dayBookTime        String  @default("22:00") @map("day_book_time")
  /// Digits with country code. Where the owner wants it.
  dayBookTo          String? @map("day_book_to")
  /// The last business day ("YYYY-MM-DD") whose Day Book was handed to the service, so a
  /// restart at 10 pm never sends the same night twice.
  dayBookLastSentFor String? @map("day_book_last_sent_for")

  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

/// What this app asked WhatsApp to send, and where it has got to.
model WhatsAppMessage {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// The WhatsApp Service's own id; ticks arrive against it.
  serviceMessageId String? @unique @map("service_message_id")

  /// PURCHASE_ORDER | GOODS_RECEIPT | BILL | RETURN_NOTE | DAY_BOOK | TEST
  kind        String
  referenceId String? @map("reference_id")
  /// Only the last four digits: enough to recognise, not a list of customers' numbers.
  toMasked    String  @map("to_masked")

  /// QUEUED | SENDING | SENT | DELIVERED | READ | FAILED | EXPIRED
  status     String  @default("QUEUED")
  failReason String? @map("fail_reason")
  /// The service's code for why (NOT_ON_WHATSAPP, MEDIA_FETCH_FAILED, ...), for counting.
  failCode   String? @map("fail_code")
  sentBy     String? @map("sent_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, kind, referenceId, createdAt])
  @@map("whatsapp_messages")
}

/// Events from the WhatsApp Service already handled. It delivers at least once, so the same
/// event can arrive twice; the second is recognised here and ignored.
model WhatsAppEventSeen {
  id         String   @id
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("whatsapp_events_seen")
}

// ── Loyalty points ────────────────────────────────────────────────────────────────────────

/// A shop's points rules. Off until the owner switches it on.
model LoyaltySettings {
  clientId String @id @map("client_id")

  enabled          Boolean @default(false)
  /// Points earned for every full ₹100 paid (points spent on a bill earn nothing).
  pointsPer100     Int     @default(1) @map("points_per_100")
  /// What one point is worth, in paise (100 = ₹1).
  pointValuePaise  Int     @default(100) @map("point_value_paise")
  /// Points a customer must hold before they can use any.
  minRedeemPoints  Int     @default(100) @map("min_redeem_points")
  /// At most this share of a bill can be paid with points.
  maxRedeemPercent Int     @default(50) @map("max_redeem_percent")
  /// Points lapse after this many months with no purchase and no points used. 0 = never.
  expiryMonths     Int     @default(12) @map("expiry_months")
  /// A gift on the customer's birthday, 0 = none. Given once a year, with the birthday wish.
  birthdayPoints   Int     @default(0) @map("birthday_points")

  /// After a counter sale, tell the customer on WhatsApp what they earned and hold.
  notifyAfterSale    Boolean @default(false) @map("notify_after_sale")
  /// Automatic wishes, sent from the shop's own number to customers who agreed to offers.
  birthdayWish       Boolean @default(false) @map("birthday_wish")
  birthdayText       String? @map("birthday_text") @db.Text
  anniversaryWish    Boolean @default(false) @map("anniversary_wish")
  anniversaryText    String? @map("anniversary_text") @db.Text
  /// A picture above the wishes (CampaignMedia ids), or none.
  birthdayMediaId    String? @map("birthday_media_id")
  anniversaryMediaId String? @map("anniversary_media_id")
  /// A week before points lapse, remind the customer to use them.
  expiryReminder     Boolean @default(false) @map("expiry_reminder")

  /// The last shop-local day ("YYYY-MM-DD") the automatic messages were prepared for.
  autoPreparedFor String? @map("auto_prepared_for")

  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("loyalty_settings")
}

enum LoyaltyEntryKind {
  EARNED
  USED
  /// A return: points used on the returned goods, given back.
  RETURN_GIVEN_BACK
  /// A return: points earned on the returned goods, taken back.
  RETURN_TAKEN_BACK
  BIRTHDAY
  EXPIRED
  /// Changed by hand, with a reason.
  ADJUSTED
}

/// Every change to a customer's points. customers.loyalty_points is their sum.
model LoyaltyEntry {
  id         String           @id @default(uuid())
  clientId   String           @map("client_id")
  customerId String           @map("customer_id")
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       LoyaltyEntryKind
  /// Signed: + earned or given, - used or taken.
  points     Int
  /// Balance right after this entry.
  balance    Int

  salesOrderId  String? @map("sales_order_id")
  salesReturnId String? @map("sales_return_id")
  note          String?
  createdById   String? @map("created_by_id")

  /// What makes this entry happen once: "EARNED:<order>", "BIRTHDAY:<customer>:2026" and so on.
  /// A retried sale or a job run twice finds the entry already there.
  onceKey String @unique @map("once_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, customerId, createdAt])
  @@index([salesOrderId])
  @@map("loyalty_entries")
}

// ── WhatsApp campaigns ────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  /// Started; each customer's short link is being made. Nothing is sent until every one exists.
  PREPARING
  SENDING
  PAUSED
  DONE
  CANCELLED
}

/// One message to many customers, from the shop's own number, handed to WhatsApp a few at a time.
model Campaign {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  name     String
  /// With {name}, {shop}, {points}, {points_value}. The STOP line is added when sent.
  text     String         @db.Text
  status   CampaignStatus @default(DRAFT)
  /// Who it is for: tags, bought within / not for N days, spent at least, points at least...
  audience Json           @default("{}")
  /// MANUAL, or the automatic kind: BIRTHDAY, ANNIVERSARY, POINTS_EXPIRING.
  source   String         @default("MANUAL")

  /// The picture sent above the words (CampaignMedia, never changed once made).
  mediaId      String?        @map("media_id")
  media        CampaignMedia? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  /// Where {link} goes: { type: WHATSAPP | PRODUCT | SHOP | EXTERNAL, target, days, productName? }.
  link         Json?
  /// What was sent, fixed at Start: words, picture, link, shop name. The page shows this, never
  /// today's product or settings. Null for a draft.
  snapshot     Json?
  /// Why making the links has not finished yet (PREPARING), in words; cleared once it has.
  prepareError String?        @map("prepare_error")

  /// Not before this moment.
  startAt    DateTime? @map("start_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipients CampaignRecipient[]

  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@map("campaigns")
}

/// One customer in one campaign. Fixed when the campaign starts; checked again just before sending.
model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   String   @map("client_id")
  customerId String   @map("customer_id")

  /// WAITING | HANDED (to WhatsApp; its own status is on whatsapp_messages) | SKIPPED | FAILED
  state      String    @default("WAITING")
  skipReason String?   @map("skip_reason")
  /// Why, as a code: OPTED_OUT | NO_CONSENT | NO_PHONE | INACTIVE | DELETED | RECENT_OFFER |
  /// CAMPAIGN_STOPPED | REFUSED. The words are in skip_reason.
  skipCode   String?   @map("skip_code")
  /// This customer's short-link token (links.newRecipientRef): random, meaningless outside this row.
  linkRef    String?   @unique @map("link_ref")
  /// Their link's code once made (go.scaleezy.com/<code>).
  linkCode   String?   @map("link_code")
  /// Our whatsapp_messages row once handed over: its ticks are this recipient's.
  messageId  String?   @unique @map("message_id")
  handedAt   DateTime? @map("handed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([campaignId, customerId])
  @@index([campaignId, state])
  @@index([clientId, handedAt])
  @@map("campaign_recipients")
}

// ── Store credit ──────────────────────────────────────────────────────────────────────────

enum StoreCreditKind {
  /// A return refunded as credit, or an exchange.
  FROM_RETURN
  /// Spent on a bill.
  USED
  /// Paid out in money after all.
  PAID_OUT
  /// Changed by hand, with a reason.
  ADJUSTED
}

/// Every change to a customer's store credit. customers.store_credit_paise is their sum.
model StoreCreditEntry {
  id           String          @id @default(uuid())
  clientId     String          @map("client_id")
  customerId   String          @map("customer_id")
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind         StoreCreditKind
  /// Signed paise: + given, - used or paid out.
  amountPaise  Int             @map("amount_paise")
  balancePaise Int             @map("balance_paise")

  salesOrderId  String?  @map("sales_order_id")
  salesReturnId String?  @map("sales_return_id")
  note          String?
  createdById   String?  @map("created_by_id")
  onceKey       String   @unique @map("once_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientId, customerId, createdAt])
  @@map("store_credit_entries")
}

// ── Short links (go.scaleezy.com) ─────────────────────────────────────────────────────────
// A module of its own (services/links): no other code reads or writes these tables. A link knows
// whose it is and where it goes, never who it was sent to -- recipient_ref is an opaque random
// token that only the module that made it can match to a person.

enum ShortLinkTarget {
  /// A product page (the shop's website today, the ScaleEzy online shop later).
  PRODUCT
  /// The shop's own page.
  SHOP
  /// A page for one campaign (online shop, later).
  CAMPAIGN
  /// A chat with the shop on WhatsApp (wa.me).
  WHATSAPP
  /// Any other web address, typed by an owner or manager.
  EXTERNAL
}

enum ShortLinkStatus {
  ACTIVE
  /// The shop switched it off; it can switch it on again.
  DISABLED_BY_SHOP
  /// ScaleEzy switched it off (a reported scam). Only ScaleEzy can switch it on again.
  DISABLED_BY_PLATFORM
}

enum ShortLinkVisitor {
  HUMAN
  /// Link-preview robots, scanners, crawlers: counted apart, never as a tap.
  BOT
}

model ShortLink {
  id       String @id @default(uuid())
  /// 7 random letters and digits: go.scaleezy.com/<code>.
  code     String @unique
  clientId String @map("client_id")

  /// What made it and for what: e.g. 'campaigns' + the campaign id.
  ownerModule  String  @map("owner_module")
  ownerRef     String? @map("owner_ref")
  /// Opaque random token from the owner, one per person, or null. Never a customer id, phone or name.
  recipientRef String? @map("recipient_ref")

  targetType ShortLinkTarget @map("target_type")
  target     String          @db.Text
  status     ShortLinkStatus @default(ACTIVE)
  expiresAt  DateTime        @map("expires_at")
  /// A test send's link: its taps are not counted in a campaign's numbers.
  isTest     Boolean         @default(false) @map("is_test")

  disabledAt   DateTime? @map("disabled_at")
  disabledById String?   @map("disabled_by_id")
  /// Why it was switched off. Kept for us; never shown to a visitor.
  disabledNote String?   @map("disabled_note")

  tapCount     Int       @default(0) @map("tap_count")
  botOpenCount Int       @default(0) @map("bot_open_count")
  firstTapAt   DateTime? @map("first_tap_at")
  lastTapAt    DateTime? @map("last_tap_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  taps ShortLinkTap[]

  /// One link per person per thing, per shop: making links again for the same people returns the
  /// same links, and one shop's references can never reach another shop's links.
  @@unique([clientId, ownerModule, ownerRef, recipientRef])
  @@index([expiresAt])
  @@map("short_links")
}

/// One open of a link: when, and person or robot. Nothing else -- no address, no browser, no place.
model ShortLinkTap {
  id      String           @id @default(uuid())
  linkId  String           @map("link_id")
  link    ShortLink        @relation(fields: [linkId], references: [id], onDelete: Cascade)
  visitor ShortLinkVisitor
  at      DateTime         @default(now())

  @@index([linkId, at])
  @@index([at])
  @@map("short_link_taps")
}

/// A picture made ready for WhatsApp: a JPEG, at most 1,600 px, under 1 MB, with no hidden photo
/// data (GPS, camera), at a random address in inventory-images/whatsapp-media/. Never changed or
/// replaced once made -- a campaign's history must show the picture that really went. Choosing
/// another picture makes another row; pictures nothing uses are removed after a few days.
model CampaignMedia {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  storagePath String   @unique @map("storage_path")
  url         String   @db.Text
  width       Int
  height      Int
  byteSize    Int      @map("byte_size")
  /// UPLOAD, or PRODUCT when made from one of the shop's product photos.
  source      String   @default("UPLOAD")
  productId   String?  @map("product_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  campaigns Campaign[]
  templates CampaignTemplate[]

  @@index([clientId, createdAt])
  @@map("campaign_media")
}

/// A campaign saved to start from again: words, picture and link choice. Not who it goes to.
model CampaignTemplate {
  id          String         @id @default(uuid())
  clientId    String         @map("client_id")
  name        String
  text        String         @db.Text
  mediaId     String?        @map("media_id")
  media       CampaignMedia? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  link        Json?
  createdById String?        @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([clientId, name])
  @@map("campaign_templates")
}

// ── The shop's own online shop (PLAN-online-shop.md) ────────────────────────────────────────

/// What a shopper sees when they open `shop.scaleezy.com/<slug>`.
///
/// One row per shop, made the moment an owner opens Settings -> Online shop, switched on only when
/// they have chosen a name and at least one location that sells online. The slug is the shop's
/// address for good: it goes into QR codes, and into WhatsApp messages that live 90 days and cannot
/// be edited afterwards, so it is never reused for a different shop even after deletion.
model OnlineShop {
  id       String @id @default(uuid())
  clientId String @unique @map("client_id")

  /// The address: lower-case letters, digits and single hyphens, 3-40 characters. Unique across
  /// every shop on ScaleEzy, because it is the whole address.
  slug String @unique

  /// Off until the owner is ready. Off means the link says the shop is not open, not 404: a
  /// customer who saved the link should be told, not left guessing.
  isLive Boolean @default(false) @map("is_live")

  /// What the shopper sees at the top. Falls back to the shop's business name and logo.
  displayName String? @map("display_name")
  logoUrl     String? @map("logo_url")
  bannerUrl   String? @map("banner_url")
  bannerPath  String? @map("banner_path")
  accent      String? // one hex colour; the rest of the palette is derived

  /// Which locations' stock may be sold online. Empty means none, so a shop cannot go live by
  /// accident and start selling the stock of a godown it never meant to offer.
  locationIds String[] @map("location_ids")

  /// A piece with no stock: hide it, or show it greyed as sold out. The shop's choice.
  hideOutOfStock Boolean @default(false) @map("hide_out_of_stock")

  /// Whether a customer can actually place an order, or only look and ask on WhatsApp.
  ///
  /// Off by default, and on is a decision: taking an order holds the shop's real stock and
  /// promises a real delivery. A shop opens its shop first, sees who looks, and turns this on
  /// when it is ready to pack boxes.
  acceptsOrders Boolean @default(false) @map("accepts_orders")

  /// How a customer may pay. Both off means no order can be placed, whatever acceptsOrders says.
  /// Paying online needs the shop's own gateway keys; paying on delivery needs nothing.
  payOnDelivery Boolean @default(true) @map("pay_on_delivery")
  payOnline     Boolean @default(false) @map("pay_online")

  /// Delivery, the shop's own terms. Free above a figure, if the shop wants that.
  deliveryFee       Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  freeDeliveryAbove Decimal? @map("free_delivery_above") @db.Decimal(10, 2)
  /// The smallest order the shop will send out. Null means it will send any.
  minOrderValue     Decimal? @map("min_order_value") @db.Decimal(10, 2)

  /// Whether this shop offers "see it on you" on its product pages.
  ///
  /// The shop's choice, because every try-on spends a generation from its own allowance. Off
  /// unless it says otherwise, and shown only where the platform has a try-on gateway at all.
  tryOn Boolean @default(false) @map("try_on")

  /// The PIN codes this shop delivers to. Empty means everywhere, which is what most shops mean
  /// when they have not thought about it. A shop that lists some is refusing the rest, and the
  /// customer is told before they have typed an address nobody will deliver to.
  deliverPincodes String[] @map("deliver_pincodes")

  /// Required on every page by the Consumer Protection (E-Commerce) Rules 2020: the shop is the
  /// seller, so its own details must be reachable. Filled from ClientSettings where they exist.
  returnPolicy   String? @map("return_policy") @db.Text
  grievanceName  String? @map("grievance_name")
  grievancePhone String? @map("grievance_phone")
  grievanceEmail String? @map("grievance_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("online_shops")
}

/// A slug that has been used, so it is never given to a different shop. Kept even when a shop is
/// deleted: a QR code printed on a poster outlives the shop that printed it, and pointing it at
/// somebody else's sarees would be worse than pointing it at nothing.
model OnlineShopSlugHistory {
  slug       String    @id
  clientId   String    @map("client_id")
  takenAt    DateTime  @default(now()) @map("taken_at")
  releasedAt DateTime? @map("released_at")

  @@index([clientId])
  @@map("online_shop_slug_history")
}

/// How a customer paid for an online order.
enum OnlineShopPayWay {
  /// Money when the goods arrive, or when they are collected. Needs no gateway and no keys, and
  /// is how most shops of this size already sell.
  ON_DELIVERY
  /// Money now, through the shop's own payment gateway.
  ONLINE
}

/// An order placed on a shop's own online shop.
///
/// The order itself is an ordinary SalesOrder on the ONLINE channel -- the same row a counter sale
/// or a Shopify order becomes, holding the same stock, priced by the same offers. This row holds
/// only what is true of an order that came from OUR shop page and nowhere else: the secret in the
/// customer's link, what the browser sent so a double tap makes one order, and how it was paid.
model OnlineShopOrder {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  salesOrderId String     @unique @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  /// What the customer's browser sent when it placed this. One per basket, so a double tap, a
  /// retry after a timeout and two requests racing all become the one order.
  placementKey String @map("placement_key")

  /// The secret in the link a customer follows to see their own order.
  ///
  /// Long and random, because it is the ONLY thing between one customer's order -- their name,
  /// their address, their phone -- and anybody who tries the next number along.
  token String @unique

  /// The number the customer typed, kept here as well as on the order: this is who the shop
  /// rings, and it must survive whatever later happens to the customer record.
  customerPhone String? @map("customer_phone")
  /// Whether that number was proved to be theirs before the order was taken.
  phoneVerified Boolean @default(false) @map("phone_verified")

  /// When an UNPROVED order stops holding the shop's stock.
  ///
  /// A shop open to the internet can be emptied by somebody typing a made-up number into a
  /// checkout twenty times: every order holds real stock, and nothing ever gave it back. An order
  /// whose number was proved has no expiry -- it is a real customer, and only the shop decides
  /// when to let it go.
  holdExpiresAt DateTime? @map("hold_expires_at")

  payWay OnlineShopPayWay @map("pay_way")
  paid   Boolean          @default(false)

  /// The gateway's own ids, for finding this payment again in the gateway's dashboard.
  gatewayOrderId   String? @map("gateway_order_id")
  gatewayPaymentId String? @map("gateway_payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, placementKey])
  @@index([clientId, createdAt])
  @@index([holdExpiresAt])
  @@map("online_shop_orders")
}

/// A code sent to a shopper's WhatsApp to prove the number they typed is theirs.
///
/// Without this anybody can order to any number, and every made-up order holds real stock the shop
/// cannot sell. With it the number is proved, which also means the order can be attached to the
/// shop's REAL customer record rather than making a new one each time -- so a regular buying
/// online is the same person the till knows, and earns their points.
///
/// The code itself is never stored. Only a hash of it, so a copy of this table is not a list of
/// live codes for every checkout in progress.
model OnlineShopPhoneCode {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// In the one stored form, the same as everywhere else.
  phone    String
  codeHash String @map("code_hash")

  /// Wrong guesses, and how many codes have gone to this number in this window. Both are what
  /// stops this being a way to send a stranger a hundred messages, or to guess a six-digit code.
  tries     Int @default(0)
  sentCount Int @default(1) @map("sent_count")

  /// Set once the code was typed back correctly. The proof lasts a little while, so a shopper who
  /// proves their number and then spends ten minutes choosing is not asked again.
  verifiedAt DateTime? @map("verified_at")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, phone])
  @@index([expiresAt])
  @@map("online_shop_phone_codes")
}

/// A banner across the top of a shop's own online shop: the picture, a few words over it, and
/// where tapping it goes. A shop may have several, which the shopper swipes through.
model OnlineShopBanner {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  imageUrl  String  @map("image_url") @db.Text
  imagePath String? @map("image_path")
  width     Int
  height    Int

  /// Words over the picture. Both optional: a photograph often says it better on its own.
  heading String?
  subtext String?

  /// Where tapping it goes. SEARCH carries the words to search for, PRODUCT a product code, so a
  /// banner can point at "Silk sarees" without anyone inventing a collections feature first.
  linkKind  OnlineShopBannerLink @default(NONE) @map("link_kind")
  linkValue String?              @map("link_value")

  orderIndex Int     @default(0) @map("order_index")
  active     Boolean @default(true)

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([clientId, orderIndex])
  @@map("online_shop_banners")
}

enum OnlineShopBannerLink {
  NONE
  SEARCH
  PRODUCT
  /// One of the shop's own departments, as the nav lists them (WOMEN, MEN...). A shop with a
  /// menswear banner should be able to send a tap there without searching for the word.
  CATEGORY
}
